<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer soft ring - darker blue so it reads on a light background -->
    <item>
        <shape android:shape="oval">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1.5dp"
                android:color="#2E1E5FC7" />
        </shape>
    </item>
    <!-- Inner brighter ring -->
    <item
        android:bottom="14dp"
        android:left="14dp"
        android:right="14dp"
        android:top="14dp">
        <shape android:shape="oval">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="2dp"
                android:color="#701E5FC7" />
        </shape>
    </item>
</layer-list>
