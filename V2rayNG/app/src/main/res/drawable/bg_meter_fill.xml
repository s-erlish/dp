<?xml version="1.0" encoding="utf-8"?>
<!--
  Meter fill: SOLID accent. No gradient — a gradient encodes nothing a solid fill of
  the same width does not (00-rules.md 6.5), and bg_traffic_gradient is the shipped
  violation. The label sits BESIDE the bar, never on top of it: the current 11sp
  label over a moving fill measures 2.9:1.
  Over quota the fill turns colorError and the label says «Лимит исчерпан».
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <size android:height="@dimen/meter_height" />
    <solid android:color="?attr/colorPrimary" />
    <corners android:radius="@dimen/radius_pill" />
</shape>
