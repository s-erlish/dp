<?xml version="1.0" encoding="utf-8"?>
<!-- progressDrawable for the traffic pill (a horizontal ProgressBar):
     - background: rounded muted track (colorSurfaceVariant), ~16dp thick pill => 8dp radius
     - progress: a clipped rounded FLAT fill in the one accent (colorPrimary).
       No white->blue gradient glow (impeccable: no decorative gradients on near-black). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="?attr/colorSurfaceVariant" />
        </shape>
    </item>

    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="8dp" />
                <solid android:color="?attr/colorPrimary" />
            </shape>
        </clip>
    </item>

</layer-list>
