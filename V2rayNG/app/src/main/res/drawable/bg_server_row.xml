<?xml version="1.0" encoding="utf-8"?>
<!-- Unified selection recipe for a server row.
     focused = 2dp blue outline (D-pad / TV); selected = 1.5dp blue + ~12% blue fill. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- D-pad / TV focus: bold blue outline so keyboard focus is always visible -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#1F4C8DFF" />
            <corners android:radius="@dimen/radius_card" />
            <stroke
                android:width="2dp"
                android:color="?attr/colorPrimary" />
        </shape>
    </item>
    <!-- Selected server: blue outline + faint blue fill -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#1F4C8DFF" />
            <corners android:radius="@dimen/radius_card" />
            <stroke
                android:width="1.5dp"
                android:color="?attr/colorPrimary" />
        </shape>
    </item>
    <!-- Default / pressed: rounded ripple, no fill -->
    <item>
        <ripple android:color="?attr/colorPrimaryContainer">
            <item android:id="@android:id/mask">
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/white" />
                    <corners android:radius="@dimen/radius_card" />
                </shape>
            </item>
        </ripple>
    </item>
</selector>
