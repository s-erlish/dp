<?xml version="1.0" encoding="utf-8"?>
<!--
  The DEFAULT icon tile, and the one most rows should use. D-5 closes the coloured
  tile set at exactly three — accent, destructive, neutral — because purple / orange
  / yellow / green encode a category system this product does not have. 56 of 65
  shipped Android tiles are blue and only 4 are neutral; that is not a category
  system, it is noise. Reaching for a fourth colour means the screen is inventing a
  taxonomy. Replaces bg_icon_neutral, which stays alive until its references migrate.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/icon_tile_neutral" />
    <corners android:radius="@dimen/radius_tile" />
</shape>
