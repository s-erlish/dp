<?xml version="1.0" encoding="utf-8"?>
<!-- Frameless bottom-nav backdrop: a faint vertical scrim that fades the scrolling
     content out under the nav buttons (transparent at the top -> surface at the
     bottom), instead of a solid opaque bar. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="?attr/colorSurface"
        android:centerColor="?attr/colorSurface"
        android:endColor="@android:color/transparent"
        android:type="linear" />
</shape>
