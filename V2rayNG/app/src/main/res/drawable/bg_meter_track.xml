<?xml version="1.0" encoding="utf-8"?>
<!--
  Traffic / determinate meter track: meter_height 6, radius_pill. Pill is legal here
  under R1's carve-out — a meter is intrinsically a track, not a wide capsule with a
  label in it — and 100dp clamps to half the 6dp height, giving true round ends
  without a bespoke 3dp token.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <size android:height="@dimen/meter_height" />
    <solid android:color="?attr/colorSurfaceContainerHighest" />
    <corners android:radius="@dimen/radius_pill" />
</shape>
