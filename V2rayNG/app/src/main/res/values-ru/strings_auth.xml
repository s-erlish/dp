<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  AUTH COPY — русская локаль. Зеркало values/strings_auth.xml.
  ============================================================================

  Копия ключ-в-ключ с values/strings_auth.xml: там русский лежит как значение по
  умолчанию (так устроены все модули этого дерева, а локаль приложения по
  умолчанию — AUTO), здесь — как явная ru-локаль. Меняются ОБА файла сразу;
  расхождение между ними — дефект.

  Правила копирайта (00-rules.md 9.2, 9.4): предложение с заглавной, без КАПСА,
  без тире, без трёх точек, «ёлочки», точка только в предложениях-ошибках и в
  body-тексте. Каждая ошибка называет причину И способ исправить, без кодов HTTP
  и без тела ответа.
-->
<resources>

    <!-- ===================== A · экран входа ===================== -->
    <!-- Латинский токен «departament» LoginActivity рисует брендовым шрифтом
         (14-auth.md 5.1, D-14.1). Слово пишется ровно так, иначе span его не
         найдёт и заголовок молча потеряет брендовый акцент. -->
    <string name="auth_gate_title">Вход в departament</string>
    <string name="auth_gate_body">Здесь будут подписка, устройства и платежи.</string>
    <string name="auth_btn_telegram">Войти через Telegram</string>
    <string name="auth_btn_email">Войти по почте</string>
    <string name="auth_awaiting_title">Ждём подтверждения в Telegram</string>
    <string name="auth_awaiting_body">Подтвердите вход в открывшемся приложении</string>
    <string name="auth_open_telegram">Открыть Telegram</string>

    <!-- E · тот же поток, но его запускает уже вошедший аккаунт. -->
    <string name="auth_link_tg_title">Привязать Telegram</string>
    <string name="auth_link_tg_body">Подтвердите привязку в Telegram. Аккаунт останется тем же.</string>
    <string name="auth_link_awaiting_body">Подтвердите привязку в открывшемся приложении</string>

    <!-- ===================== B · вход по почте ===================== -->
    <string name="auth_email_title">Вход по почте</string>
    <string name="auth_email_label">Электронная почта</string>
    <string name="auth_email_placeholder">name@example.com</string>
    <string name="auth_password_label">Пароль</string>
    <string name="auth_btn_signin">Войти</string>

    <!-- Два дела, которые приложение не умеет доделать само: в клиенте бэкенда нет
         ни регистрации, ни сброса пароля, поэтому обе строки — честная передача в
         браузер, и подпись говорит, куда именно. -->
    <string name="auth_row_register">Создать аккаунт</string>
    <string name="auth_row_register_sub">Регистрация на departament.site</string>
    <string name="auth_row_reset">Восстановить пароль</string>
    <string name="auth_row_reset_sub">Сброс пароля на departament.site</string>

    <!-- ===================== 2FA ===================== -->
    <string name="auth_2fa_label">Код из приложения-аутентификатора</string>
    <string name="auth_2fa_a11y">Код из приложения, 6 цифр</string>
    <string name="auth_btn_2fa">Подтвердить</string>
    <string name="auth_cancel">Отмена</string>
    <string name="auth_2fa_wrong">Неверный код. Проверьте приложение-аутентификатор.</string>

    <!-- ===================== ошибки (14-auth.md 13.1) ===================== -->
    <string name="auth_email_invalid">Введите корректный email, например name@example.com</string>
    <!-- Строка поля, не ошибка экрана: «Готово» при пустом пароле раньше не делало ничего. -->
    <string name="auth_password_required">Введите пароль</string>
    <string name="auth_err_credentials">Неверная почта или пароль. Проверьте и повторите.</string>
    <string name="auth_err_gone">Ссылка устарела. Начните вход заново.</string>
    <string name="auth_err_rate_limited">Слишком много попыток. Повторите через минуту.</string>
    <string name="auth_err_unavailable">Сервис временно недоступен. Повторите через пару минут.</string>
    <string name="auth_err_network">Нет подключения к интернету. Проверьте сеть и повторите.</string>
    <string name="auth_err_timeout">Сервер не отвечает. Повторите позже.</string>
    <string name="auth_err_tg_timeout">Мы не дождались подтверждения. Начните заново.</string>
    <string name="auth_err_not_configured">Вход сейчас недоступен. Повторите попытку позже.</string>
    <string name="auth_err_generic">Что-то пошло не так. Повторите попытку.</string>
    <string name="auth_err_telegram_missing">Telegram не установлен. Войдите по почте.</string>
    <!-- Та же ошибка в режиме «Привязать Telegram»: там «войдите по почте» бессмысленно, аккаунт
         уже вошёл, и Telegram — единственное, что нужно этому действию. -->
    <string name="auth_err_link_telegram_missing">Telegram не установлен. Установите приложение и повторите привязку.</string>
    <string name="auth_err_browser_missing">Не нашли браузер, чтобы открыть сайт. Зайдите на departament.site с другого устройства.</string>

    <!-- ===================== доступность ===================== -->
    <string name="auth_loading_cd">%1$s, загрузка</string>
</resources>
