<?xml version="1.0" encoding="utf-8"?>
<!--
  ГЛАВНАЯ - the Russian locale copy of res/values/strings_home.xml.

  The two files carry the same text on purpose: values/ is the fallback for every
  locale and this product's interface language is Russian, so whichever one a
  device resolves, the screen reads the same. Change one, change both.
-->
<resources>

    <!-- ===================================================================== -->
    <!-- The status line under the connect object. The WORD carries the state;  -->
    <!-- its colour only reinforces it, and there is no status dot.             -->
    <!-- ===================================================================== -->
    <string name="home_status_disconnected">Отключено</string>
    <string name="home_status_connecting">Подключение…</string>
    <string name="home_status_connected">Подключено</string>
    <string name="home_status_disconnecting">Отключение…</string>
    <string name="home_status_error">Не удалось подключиться</string>
    <string name="home_status_no_server">Сервер не выбран</string>
    <string name="home_status_no_servers">Нет серверов</string>
    <string name="home_status_no_subscription">Подписки нет</string>
    <string name="home_status_expired">Подписка истекла</string>
    <string name="home_detail_retry">Нажмите, чтобы повторить</string>
    <!-- The list is on this screen now, so the hint points at it and not at a
         destination the owner removed. -->
    <string name="home_detail_pick_server">Выберите сервер в списке ниже</string>
    <!-- The server identity under the object: name, then the live latency once a
         probe has landed. U+00B7, never a hyphen. -->
    <string name="home_server_latency">%1$s · %2$d мс</string>

    <!-- ===================================================================== -->
    <!-- The top strip: отдача · время сессии · приём, in that order, on the     -->
    <!-- same line as the add action. The UNIT lives in the label so the value   -->
    <!-- stays a pure figure and its reserved width never has to grow for it.    -->
    <!-- ===================================================================== -->
    <string name="home_strip_up_label">Отдача, Мбит/с</string>
    <string name="home_strip_uptime_label">Время сессии</string>
    <string name="home_strip_down_label">Приём, Мбит/с</string>
    <string name="home_speed_zero" translatable="false">0,0</string>
    <string name="home_uptime_zero" translatable="false">00:00:00</string>
    <string name="home_uptime_format" translatable="false">%1$02d:%2$02d:%3$02d</string>

    <!-- The add action, top right. B1: he calls this thing a подписка. -->
    <string name="home_add_subscription">Добавить подписку</string>

    <!-- ===================================================================== -->
    <!-- The header row. Signed out it is a NAVIGATION row, never a call to     -->
    <!-- action: the verb lives on the gate primary, exactly once.              -->
    <!-- ===================================================================== -->
    <string name="home_account_title">Аккаунт</string>
    <string name="home_account_subtitle">Вход, подписка, устройства</string>
    <string name="home_account_manage">Управление аккаунтом</string>

    <!-- ===================================================================== -->
    <!-- The gate block, shown INSTEAD of the subscription card and the server  -->
    <!-- list when there is not one server to connect to. Never beside them.    -->
    <!-- ===================================================================== -->
    <string name="home_gate_signin_caption">Войдите, чтобы получить серверы departament.</string>
    <string name="home_gate_signin">Войти</string>
    <string name="home_gate_add_subscription">Добавить подписку</string>
    <!-- The build with no backend configured: signing in is meaningless there, so
         adding a подписка is the primary and there is no secondary. -->
    <string name="home_gate_subscription_caption">Добавьте подписку, чтобы получить серверы.</string>
    <string name="home_gate_buy_caption">Осталось выбрать тариф.</string>
    <string name="home_gate_buy">Купить подписку</string>
    <!-- Offered under the buy CTA while the account has no Telegram attached. It
         is the only live entry point to linking Telegram on this screen, and it
         went missing when the onboarding card was replaced; it is back. -->
    <string name="home_gate_link_telegram">Привязать Telegram</string>
    <string name="home_gate_sync_caption">Подписка активна, серверы ещё не загружены.</string>
    <string name="home_gate_sync">Загрузить серверы</string>
    <string name="home_gate_sync_failed_caption">Не удалось загрузить серверы. Проверьте соединение.</string>
    <string name="home_gate_retry">Повторить</string>

    <!-- ===================================================================== -->
    <!-- The inline status strip. A CONDITION, not an event: at most one is     -->
    <!-- shown and the priority order lives in HomeFragment.                    -->
    <!-- ===================================================================== -->
    <string name="home_condition_expired">Подписка истекла. Продлите её, чтобы подключаться.</string>
    <string name="home_condition_expiring">Подписка заканчивается %1$s.</string>
    <string name="home_condition_offline">Нет сети. Показаны последние данные.</string>
    <string name="home_condition_silent">Сервер не отвечает. Выберите другой в списке ниже.</string>
    <string name="home_condition_loading">Обновляем данные…</string>
    <string name="home_stale_hint">Данные могли устареть</string>

    <string name="home_action_renew">Продлить</string>
    <string name="home_action_retry">Повторить</string>

    <!-- ===================================================================== -->
    <!-- Accessible names for the connect object: STATE and ACTION, never just  -->
    <!-- the verb.                                                              -->
    <!-- ===================================================================== -->
    <string name="home_cd_connect">Отключено. Нажмите, чтобы подключить</string>
    <string name="home_cd_cancel">Подключение. Нажмите, чтобы отменить</string>
    <string name="home_cd_disconnect">Подключено. Нажмите, чтобы отключить</string>
    <string name="home_cd_locked">Недоступно. Нет подписки</string>

    <!-- ===================================================================== -->
    <!-- THE SUBSCRIPTION CARD under the connect object - the pill, the meta    -->
    <!-- line, the operator's notice and the card's own actions. It is a CARD   -->
    <!-- on this screen, not a row that navigates away.                         -->
    <!-- ===================================================================== -->
    <!-- Last resort only: the account nickname, then the provider's own title,
         then the subscription's remark all come first. -->
    <string name="home_sub_untitled">Подписка</string>
    <!-- «09.07.2026 07:08 · Автообновление: 1 ч» -->
    <string name="home_sub_meta">%1$s · %2$s</string>
    <string name="home_sub_updated_never">Ещё не обновлялась</string>
    <string name="home_sub_auto_update">Автообновление: %1$s</string>
    <string name="home_sub_auto_update_off">выкл</string>
    <string name="home_sub_interval_hours">%1$d ч</string>
    <string name="home_sub_interval_minutes">%1$d мин</string>
    <string name="home_sub_traffic_used" translatable="false">%1$s / %2$s</string>
    <string name="home_sub_traffic_unlimited" translatable="false">%1$s / ∞</string>
    <string name="home_sub_infinity" translatable="false">∞</string>
    <string name="home_sub_expires">до %1$s</string>
    <string name="home_sub_expired">истекла</string>

    <string name="home_sub_cd_expand">Показать серверы</string>
    <string name="home_sub_cd_collapse">Скрыть серверы</string>
    <string name="home_sub_cd_ping">Проверить задержку серверов</string>
    <string name="home_sub_cd_refresh">Обновить подписку</string>
    <string name="home_sub_cd_pin">Закрепить подписку</string>
    <string name="home_sub_cd_unpin">Открепить подписку</string>
    <string name="home_sub_cd_support">Поддержка</string>
    <string name="home_sub_cd_telegram">Открыть Telegram</string>

    <string name="home_sub_delete_title">Удалить подписку?</string>
    <string name="home_sub_delete_message">Подписка и её серверы будут удалены с этого устройства.</string>
    <string name="home_sub_delete_confirm">Удалить</string>
    <string name="home_sub_deleted">Подписка удалена</string>
    <string name="home_sub_refresh_failed">Не удалось обновить подписки</string>

    <!-- What the status strip says when a refresh failed and the screen keeps its
         last values rather than emptying. -->
    <string name="home_sub_stale">Не удалось обновить</string>

    <!-- ===================================================================== -->
    <!-- Dates. «14 августа» inside the current year, «14 августа 2027»         -->
    <!-- otherwise. The month name is a resource rather than                    -->
    <!-- SimpleDateFormat("d MMMM"), because that formatter follows the DEVICE  -->
    <!-- locale: on an English phone it prints «Действует до 14 August».        -->
    <!-- ===================================================================== -->
    <string name="home_date_short">%1$d %2$s</string>
    <string name="home_date_full">%1$d %2$s %3$d</string>
    <string name="home_date_numeric_time" translatable="false">dd.MM.yyyy HH:mm</string>
    <string-array name="home_months_genitive">
        <item>января</item>
        <item>февраля</item>
        <item>марта</item>
        <item>апреля</item>
        <item>мая</item>
        <item>июня</item>
        <item>июля</item>
        <item>августа</item>
        <item>сентября</item>
        <item>октября</item>
        <item>ноября</item>
        <item>декабря</item>
    </string-array>

</resources>
