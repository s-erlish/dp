<?xml version="1.0" encoding="utf-8"?>
<!--
  Icon-button glyph, .Danger modifier. ?attr/iconTintRed so ThemeOverlay.Mono can
  neutralise it with everything else; red is the one hue Mono keeps semantic.
-->
