<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Строки вкладки настроек (SettingsTabFragment + fragment_settings_tab.xml).

         Словарь: то, что раньше называлось «провайдером», везде называется
         подпиской; departament пишется строчными. -->

    <string name="settings_local_proxy">Локальный прокси</string>
    <string name="settings_local_proxy_sub">Порт, логин и пароль, доступ по сети</string>

    <string name="settings_provider">Настройки подписок</string>
    <string name="settings_provider_sub">Автообновление, сеть, список серверов</string>

    <!-- Список подписок (SubSettingActivity). Экран умеет добавлять, обновлять,
         включать и удалять подписку, и до этой волны на него не вело ничего:
         поэтому подписку нельзя было удалить с телефона. -->
    <string name="settings_subs_list">Список подписок</string>
    <string name="settings_subs_list_sub">Добавить, обновить, удалить</string>

    <!-- Подзаголовок строки «Другие способы добавления». Заголовок берётся из
         @string/add_other_methods_title — той же строки, что стоит в шапке
         открывающегося выбора, чтобы строка и её экран никогда не разошлись
         в словах.

         Владелец оставил в меню «Добавить подписку» только QR и буфер обмена
         (OWNER C1); три остальных способа — ссылка, сервер вручную, файл
         конфигурации — переехали в MainActivity.showAdvancedAddMethods() и до этой
         строки не вызывались ниоткуда. Способы не удалены, у них сменился вход. -->
    <string name="settings_add_other_sub">Вставить ссылку, создать сервер, импортировать файл</string>

    <string name="settings_url_scheme">Схемы URL-адресов</string>
    <string name="settings_url_scheme_sub">Быстрые команды depv://</string>

    <!-- Режим подключения. Названия и порядок заданы владельцем: TUN, Proxy,
         TUN + Proxy. Значения латиницей, поэтому translatable="false".
           TUN         - PREF_MODE = VPN, PREF_PROXY_SHARING = false
           Proxy       - PREF_MODE = «Proxy only»
           TUN + Proxy - PREF_MODE = VPN, PREF_PROXY_SHARING = true -->
    <string name="settings_mode_value_tun" translatable="false">TUN</string>
    <string name="settings_mode_value_proxy" translatable="false">Proxy</string>
    <string name="settings_mode_value_tun_proxy" translatable="false">TUN + Proxy</string>

    <!-- Оформление (выбор темы: светлая / тёмная / чёрно-белая) -->
    <string name="settings_appearance">Оформление</string>
    <string name="settings_appearance_light">Светлая</string>
    <string name="settings_appearance_dark">Тёмная</string>
    <string name="settings_appearance_mono">Чёрно-белая</string>

    <!-- IPv6 -->
    <string name="settings_ipv6">IPv6</string>
    <string name="settings_ipv6_sub">Включить IPv6-адресацию в туннеле</string>

    <!-- Постоянный VPN и блокировка трафика без VPN -->
    <string name="settings_always_on">Постоянный VPN и блокировка</string>
    <string name="settings_always_on_sub">Подключаться всегда и блокировать трафик без VPN</string>
    <string name="settings_always_on_hint">Включите постоянный VPN и блокировку без VPN в системных настройках</string>

    <!-- Автообновление подписки: нет подписок. Значение строки повторяет ps_no_subs_value
         на экране «Настройки подписок» — одно состояние называется одинаково на обоих
         экранах, иначе строка читается как «выключено», хотя включать нечего. -->
    <string name="settings_sub_auto_update_empty">Сначала добавьте подписку</string>
    <string name="settings_sub_auto_update_none">Нет подписок</string>

    <!-- DNS-пресеты -->
    <string name="settings_dns_custom">Свой…</string>

    <string-array name="dns_preset_names">
        <item>Cloudflare</item>
        <item>Google</item>
        <item>Cloudflare + Google</item>
        <item>AdGuard</item>
        <item>Quad9</item>
        <item>@string/settings_dns_custom</item>
    </string-array>

    <string-array name="dns_preset_values">
        <item>1.1.1.1</item>
        <item>8.8.8.8</item>
        <item>1.1.1.1,8.8.8.8</item>
        <item>94.140.14.14</item>
        <item>9.9.9.9</item>
        <item></item>
    </string-array>

</resources>
