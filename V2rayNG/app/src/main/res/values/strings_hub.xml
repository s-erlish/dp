<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        ВКЛАДКА «НАСТРОЙКИ» — формулировки из дизайна (handoff README §6 и прототип).

        Указание владельца 2026-08-04: «что есть в дизайне самом сами текста, все это надо
        оставить». То есть заголовки строк, подписи и списки выбора берутся из прототипа
        дословно — там, где прежняя формулировка в репозитории отличалась.

        Здесь только те строки, у которых дизайн даёт СВОЮ редакцию. Всё, что уже совпадает
        («Режим», «DNS», «Пинг», «Оформление», «Язык», «Маршрутизация», «Файлы ресурсов»,
        «Журнал», «Резервное копирование», список DNS-пресетов, «HTTP-запрос»,
        «TCP-соединение», …), читается из `strings.xml` и `strings_settings_hub.xml` — заводить
        второе имя для одного и того же текста нельзя.

        И здесь НЕТ ни одной строки для того, чего в дизайне нет: «Число соединений Mux»,
        «Настройки подписок», «Принять подписку», «Схемы URL-адресов» остаются на своих
        прежних именах. Граница, которую провёл владелец: интерфейс и формулировки — по
        дизайну, возможности — по репозиторию.
    -->

    <!-- ===================================================================== -->
    <!-- ПОДПИСИ СТРОК — НЕ ПОКАЗЫВАЮТСЯ с 0.4.9. НИ ОДНА НЕ УДАЛЕНА.           -->
    <!--                                                                        -->
    <!-- Владелец: «эти все кнопки вкладки они некоторые больше по высоте, чем   -->
    <!-- некоторые, например где ipv6, обход локальной сети… надо подравнять     -->
    <!-- такие кнопки под обычный размер как условно у dns, у режима, чтобы      -->
    <!-- была единая высота правильная».                                         -->
    <!--                                                                        -->
    <!-- Подпись в строке сама решала, какой строка будет высоты: пока она       -->
    <!-- влезала в одну строчку, ряд оставался 60dp, а «Разбивает рукопожатие    -->
    <!-- против DPI» и «Подключаться после перезагрузки» на 360dp переносятся    -->
    <!-- на вторую и тянут ряд до 76dp. Укоротить их ещё раз — значит отложить   -->
    <!-- ту же поломку до следующего перевода; поэтому подписи сняты в месте     -->
    <!-- вызова (fragment_settings_tab.xml), ровно как у @id/row_mode и          -->
    <!-- @id/row_ru_preset на «Прокси по приложениям» в том же круге правок.     -->
    <!--                                                                        -->
    <!-- У всех шести НЕТ НИ ОДНОГО ЧИТАТЕЛЯ — ни в Kotlin, ни в разметке.       -->
    <!-- Оставлены, потому что уточнение — это не удаление, и потому что место   -->
    <!-- для такого текста есть: подэкран, который строка открывает, или         -->
    <!-- пояснение под заголовком (@id/toolbar_note), где его читают целиком.    -->
    <!-- ОБРАТНО В ДВУСТРОЧНУЮ СТРОКУ НЕ ВОЗВРАЩАТЬ.                             -->
    <!-- ===================================================================== -->

    <!-- Было: «Прямой доступ к устройствам в локальной сети». -->
    <string name="hub_bypass_lan_sub">Прямой доступ к устройствам</string>
    <!-- Было: «Включить IPv6-адресацию в туннеле». -->
    <string name="hub_ipv6_sub">Адресация IPv6 в туннеле</string>
    <!-- ЕДИНСТВЕННОЕ описание того, что делает «Локальный прокси»: сам заголовок
         называет вещь, но не говорит, что за ней. Если объяснение нужно — ему место
         на самом экране LocalProxyActivity, а не второй строкой в ряду. -->
    <string name="hub_local_proxy_sub">Порт, логин и доступ по сети</string>
    <!-- Было: «Объединяет запросы в один канал соединения». -->
    <string name="hub_mux_sub">Запросы в одном канале</string>
    <!-- Было: «Разбивает TLS-рукопожатие против DPI». -->
    <string name="hub_fragment_sub">Разбивает рукопожатие против DPI</string>
    <!-- Было: «Подключаться после перезагрузки устройства». -->
    <string name="hub_boot_sub">Подключаться после перезагрузки</string>

    <!-- Заголовок и подпись «Постоянного VPN». Было: «Постоянный VPN и блокировка» /
         «Подключаться всегда и блокировать трафик без VPN» — заголовок в две строки
         и подпись в три. Дизайн разносит их по ролям: чем строка называется наверху,
         что она делает — снизу.
         hub_always_on_sub НЕ ПОКАЗЫВАЕТСЯ с 0.4.9 и, как и hub_local_proxy_sub, был
         ЕДИНСТВЕННЫМ объяснением строки: «Постоянный VPN» — это название системной
         настройки Android, а «Блокировать трафик без VPN» — то, ради чего её
         включают. Строка ведёт в системные настройки VPN, и там же показывается
         settings_always_on_hint — то есть подсказка не исчезла, она сдвинулась туда,
         где её читают перед действием. -->
    <string name="hub_always_on">Постоянный VPN</string>
    <string name="hub_always_on_sub">Блокировать трафик без VPN</string>

    <!-- ===================================================================== -->
    <!-- СПИСКИ ВЫБОРА (§6, «Списки вариантов»).                                -->
    <!-- ===================================================================== -->

    <!--
        РЕЖИМ. Прототип: `MODES = ['TUN', 'Только прокси']`, и владелец подтвердил
        2026-08-04, что список показывает ровно это.

        Было `settings_mode_value_proxy` = «Proxy» — латиницей и с translatable="false".
        Русское «Только прокси» переводимо, поэтому это новое имя, а не правка старого:
        `settings_mode_value_proxy` остаётся объявленным в strings_settings_hub.xml, но
        строку больше не рисует — и то, и другое читателю видно из SettingsTabFragment.
        Удалять его отсюда нельзя: файл чужой, а имя вполне может понадобиться экрану,
        которому нужен именно латинский «Proxy».

        `settings_mode_value_tun_proxy` («TUN + Proxy») тоже никуда не делся. Третий
        режим в приложении есть, его умеет и ядро, и SettingsTabFragment — но в СПИСКЕ
        его больше нет, потому что в дизайне его нет. Строка продолжает показывать
        «TUN + Proxy» тому, кто его когда-то выбрал: см. SettingsTabFragment.pickMode.
    -->
    <string name="hub_mode_proxy">Только прокси</string>

    <!--
        ПИНГ. Прототип: `PINGS = ['Реальная задержка', 'HTTP-запрос', 'TCP-соединение',
        'ICMP (ping)']` — и порядок здесь тоже дизайнерский, real → http → tcp → icmp,
        а не тот, в котором методы объявлены в enum.

        «HTTP-запрос» и «TCP-соединение» совпадают дословно и читаются из strings.xml.
        Отличаются только два: было «Реальная задержка (через туннель)» и
        «ICMP (системный пинг)». Оба метода остаются рабочими (П-26) — короче стала
        подпись, а не список.
    -->
    <string name="hub_ping_real">Реальная задержка</string>
    <string name="hub_ping_icmp">ICMP (ping)</string>

    <!--
        ОФОРМЛЕНИЕ. Прототип: `THEMES_OPTS = ['Тёмная', 'Светлая', 'Чёрно-белая',
        'Как в системе']` — четвёртый вариант, которого в списке не было, хотя
        `SettingsManager.setNightMode()` уже умеет `MODE_NIGHT_FOLLOW_SYSTEM` под
        ключом PREF_UI_MODE_NIGHT = "0". Три остальных берутся из
        strings_settings_hub.xml как есть.
    -->
    <string name="hub_appearance_system">Как в системе</string>

    <!--
        АВТООБНОВЛЕНИЕ ПОДПИСКИ. Прототип: `AUTOUP = ['1 час', '3 часа', '6 часов',
        '12 часов', 'Раз в сутки', 'Выключено']`.

        Против прежнего списка: добавились «3 часа», «Выключено» переехало в конец, а
        «24 часа» дизайн называет «Раз в сутки». «1 час», «6 часов» и «12 часов»
        совпадают дословно и читаются из strings.xml.

        Выключение осталось — это возможность, а не формулировка (П-27): без него
        нельзя перестать обновлять подписку по расписанию.
    -->
    <string name="hub_sub_auto_update_3h">3 часа</string>
    <string name="hub_sub_auto_update_daily">Раз в сутки</string>
    <string name="hub_sub_auto_update_off">Выключено</string>

</resources>
