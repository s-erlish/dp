<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Common base theme: put all shared items here so day/night can reuse -->
    <style name="AppThemeBase" parent="Theme.Material3.DayNight">
        <!-- Primary colors - main tone: black -->
        <item name="colorPrimary">@color/md_theme_primary</item>
        <item name="colorOnPrimary">@color/md_theme_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_onPrimaryContainer</item>

        <!-- Secondary colors - accent color: orange -->
        <item name="colorSecondary">@color/md_theme_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_theme_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_theme_onSecondaryContainer</item>

        <!-- Tertiary colors - tertiary color: green -->
        <item name="colorTertiary">@color/md_theme_tertiary</item>
        <item name="colorOnTertiary">@color/md_theme_onTertiary</item>
        <item name="colorTertiaryContainer">@color/md_theme_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/md_theme_onTertiaryContainer</item>

        <!-- Error colors -->
        <item name="colorError">@color/md_theme_error</item>
        <item name="colorOnError">@color/md_theme_onError</item>
        <item name="colorErrorContainer">@color/md_theme_errorContainer</item>
        <item name="colorOnErrorContainer">@color/md_theme_onErrorContainer</item>

        <!-- Surface colors -->
        <item name="colorSurface">@color/md_theme_surface</item>
        <item name="colorOnSurface">@color/md_theme_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_theme_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_onSurfaceVariant</item>
        <item name="colorSurfaceInverse">@color/md_theme_inverseSurface</item>
        <item name="colorOnSurfaceInverse">@color/md_theme_inverseOnSurface</item>
        <item name="colorSurfaceContainer">@color/md_theme_surfaceContainer</item>
        <item name="colorSurfaceContainerHigh">@color/md_theme_surfaceContainerHigh</item>
        <item name="colorSurfaceContainerHighest">@color/md_theme_surfaceContainerHighest</item>
        <item name="colorSurfaceContainerLow">@color/md_theme_surfaceContainerLow</item>
        <item name="colorSurfaceContainerLowest">@color/md_theme_surfaceContainerLowest</item>

        <!-- Background colors -->
        <item name="android:colorBackground">@color/md_theme_background</item>
        <item name="colorOnBackground">@color/md_theme_onBackground</item>

        <!-- Outline colors -->
        <item name="colorOutline">@color/md_theme_outline</item>
        <item name="colorOutlineVariant">@color/md_theme_outlineVariant</item>

        <!-- Other colors -->
        <item name="colorPrimaryInverse">@color/md_theme_inversePrimary</item>

        <!-- Edge-to-edge: fully transparent system bars so the home gradient
             draws underneath them. Disable the auto contrast scrim (API 29+). -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>

        <!-- Connect button state colors (blue theme).
             connectedColor = blue accent so the connected shield matches the
             blue glow/ring (was green -> mismatched with the blue halo). -->
        <item name="connectIdleColor">@color/color_fab_inactive</item>
        <item name="connectActiveColor">@color/color_fab_active</item>
        <item name="connectedColor">@color/color_fab_active</item>

        <!-- Themed accents (coloured; Mono overlay neutralises these to grey) -->
        <item name="chipTypeText">@color/chip_type_text</item>
        <item name="chipJsonText">@color/chip_json_text</item>
        <item name="chipJsonBg">@color/chip_json_bg</item>
        <item name="pingGood">@color/ping_good</item>
        <item name="pingBad">@color/ping_bad</item>
        <item name="indicatorColor">@color/colorIndicator</item>
        <item name="iconTintBlue">@color/icon_blue</item>
        <item name="iconTintGreen">@color/icon_green</item>
        <item name="iconTintOrange">@color/icon_orange</item>
        <item name="iconTintPurple">@color/icon_purple</item>
        <item name="iconTintRed">@color/icon_red</item>
        <item name="iconTintYellow">@color/icon_yellow</item>
        <item name="iconTileBgBlue">@color/icon_tile_blue</item>
        <item name="iconTileBgGreen">@color/icon_tile_green</item>
        <item name="iconTileBgOrange">@color/icon_tile_orange</item>
        <item name="iconTileBgPurple">@color/icon_tile_purple</item>
        <item name="iconTileBgRed">@color/icon_tile_red</item>
        <item name="iconTileBgYellow">@color/icon_tile_yellow</item>
    </style>

    <!-- Day/Night theme: inherit common values and set light-mode-specific items -->
    <style name="AppThemeDayNight" parent="AppThemeBase">
        <!-- day/night-specific overrides (light/default) -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <!-- Theme without ActionBar -->
    <style name="AppThemeDayNight.NoActionBar" parent="AppThemeDayNight">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="AppThemeDayNight.NoActionBar.Translucent">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowIsTranslucent">true</item>
    </style>

    <style name="BrandedSwitch" parent="AppThemeDayNight">
        <item name="colorPrimary">@color/color_fab_active</item>
    </style>

    <!-- Mono (black & white) color overlay, applied at runtime in BaseActivity
         when the user selects the monochrome theme. Only overrides color tokens,
         so it composes with any base theme variant (NoActionBar / Translucent). -->
    <style name="ThemeOverlay.Mono" parent="">
        <item name="colorPrimary">@color/mono_primary</item>
        <item name="colorOnPrimary">@color/mono_onPrimary</item>
        <item name="colorPrimaryContainer">@color/mono_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/mono_onPrimaryContainer</item>
        <item name="colorSecondary">@color/mono_secondary</item>
        <item name="colorOnSecondary">@color/mono_onSecondary</item>
        <item name="colorSecondaryContainer">@color/mono_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/mono_onSecondaryContainer</item>
        <item name="colorTertiary">@color/mono_tertiary</item>
        <item name="colorOnTertiary">@color/mono_onTertiary</item>
        <item name="colorTertiaryContainer">@color/mono_primaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/mono_onPrimaryContainer</item>
        <item name="colorSurface">@color/mono_surface</item>
        <item name="colorOnSurface">@color/mono_onSurface</item>
        <item name="colorSurfaceVariant">@color/mono_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/mono_onSurfaceVariant</item>
        <item name="colorSurfaceContainer">@color/mono_surfaceContainer</item>
        <item name="colorSurfaceContainerHigh">@color/mono_surfaceContainerHigh</item>
        <item name="colorSurfaceContainerHighest">@color/mono_surfaceContainerHighest</item>
        <item name="colorSurfaceContainerLow">@color/mono_surfaceContainerLow</item>
        <item name="colorSurfaceContainerLowest">@color/mono_surfaceContainerLowest</item>
        <item name="android:colorBackground">@color/mono_background</item>
        <item name="colorOnBackground">@color/mono_onBackground</item>
        <item name="colorOutline">@color/mono_outline</item>
        <item name="colorOutlineVariant">@color/mono_outlineVariant</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
        <item name="connectIdleColor">@color/mono_fab_inactive</item>
        <item name="connectActiveColor">@color/mono_fab_active</item>
        <item name="connectedColor">@color/mono_connected</item>

        <!-- Accents neutralised to greyscale (mono_* colours vary day/night) -->
        <item name="chipTypeText">@color/mono_onPrimaryContainer</item>
        <item name="chipJsonText">@color/mono_onSurface</item>
        <item name="chipJsonBg">@color/mono_surfaceContainerHighest</item>
        <item name="pingGood">@color/mono_onSurfaceVariant</item>
        <item name="pingBad">@color/mono_onSurface</item>
        <item name="indicatorColor">@color/mono_primary</item>
        <item name="iconTintBlue">@color/mono_onSurfaceVariant</item>
        <item name="iconTintGreen">@color/mono_onSurfaceVariant</item>
        <item name="iconTintOrange">@color/mono_onSurfaceVariant</item>
        <item name="iconTintPurple">@color/mono_onSurfaceVariant</item>
        <item name="iconTintRed">@color/mono_onSurfaceVariant</item>
        <item name="iconTintYellow">@color/mono_onSurfaceVariant</item>
        <item name="iconTileBgBlue">@color/mono_surfaceContainerHighest</item>
        <item name="iconTileBgGreen">@color/mono_surfaceContainerHighest</item>
        <item name="iconTileBgOrange">@color/mono_surfaceContainerHighest</item>
        <item name="iconTileBgPurple">@color/mono_surfaceContainerHighest</item>
        <item name="iconTileBgRed">@color/mono_surfaceContainerHighest</item>
        <item name="iconTileBgYellow">@color/mono_surfaceContainerHighest</item>
    </style>

</resources>
