<?xml version="1.0" encoding="utf-8"?>
<!-- THE CONFIRM RING. One ring, emitted at the instant the tunnel confirms and by no
     other event in the product: it scales out from the disc's own edge and fades to
     nothing over the shared emphasis tempo (@integer/motion_emphasis, 600ms),
     ease-out only. Fires ONCE - never loops, and there is never a second ring.

     1.0 -> 1.35, not the 1.6 this file used to carry. The view it plays on is the
     DISC's size (176dp) inside a 224dp frame, so 1.35 carries the ring just past the
     outermost of the three concentric rings and stops there. 1.6 was the figure from
     when the pulse view was the frame's own size; at 176dp it throws the ring 281dp
     wide - straight across the status line under the object.

     It starts at 0.6 rather than opaque because it is emitted OVER three rings that
     are already accent-coloured at that moment, and a fully opaque fourth ring reads
     as a flash rather than as the object confirming.

     HomeFragment hides the view on end. Reduced motion skips loading this entirely -
     the ring is not emitted at all - while the confirm haptic still fires. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="@integer/motion_emphasis"
    android:fillAfter="false"
    android:interpolator="@interpolator/ease_out_quint">

    <scale
        android:fromXScale="1.0"
        android:fromYScale="1.0"
        android:pivotX="50%"
        android:pivotY="50%"
        android:toXScale="1.35"
        android:toYScale="1.35" />

    <alpha
        android:fromAlpha="0.6"
        android:toAlpha="0.0" />

</set>
