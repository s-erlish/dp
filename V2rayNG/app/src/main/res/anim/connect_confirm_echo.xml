<?xml version="1.0" encoding="utf-8"?>
<!-- THE ECHO OF THE CONFIRM RING — the second half of the desktop's connect payoff
     (ConnectHeroView.axaml, Ellipse.Sonar.pulsing-echo, P2-1).

     The lead ring says "confirmed"; this one, quieter and a beat behind it, is what
     makes the moment land as «залочено» rather than as a single blip. Android emitted
     the lead ring and nothing after it, which is the animation the owner was missing.

     TWO RINGS, NEVER THREE. The desktop's own note is explicit: «максимум ДВА кольца,
     не радар». A third would turn a confirmation into a sweep.

     Against @anim/connect_confirm: starts at alpha 0.35 rather than 0.6 (the desktop's
     0.5-of-1.0 ratio, carried onto our dimmer lead ring), travels 1.30 rather than
     1.35 so it settles just inside its leader, and starts one motion_press_in later
     (~90ms, the desktop's ~120 on our faster clock). Same 600ms emphasis tempo, same
     ease_out_quint, ONE iteration, and HomeFragment hides the view on end.

     Reduced motion skips it exactly as it skips the lead ring: neither is emitted. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="@integer/motion_emphasis"
    android:fillAfter="false"
    android:interpolator="@interpolator/ease_out_quint"
    android:startOffset="@integer/motion_press_in">

    <scale
        android:fromXScale="1.0"
        android:fromYScale="1.0"
        android:pivotX="50%"
        android:pivotY="50%"
        android:toXScale="1.30"
        android:toYScale="1.30" />

    <alpha
        android:fromAlpha="0.35"
        android:toAlpha="0.0" />

</set>
