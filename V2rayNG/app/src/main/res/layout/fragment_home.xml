<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  ГЛАВНАЯ. The screen the app opens on. 13-start-screen.md, sections 3 and 4.
  ============================================================================

  ONE GLANCE ANSWERS THREE QUESTIONS, IN THIS ORDER (13 s. 1):
    1. Am I protected?   the disc, and the word under it
    2. Through what?     the server name, directly under the word
    3. What next?        exactly one thing, and only when there is something to do

  THE FRAME, top to bottom. The rhythm is four values and they are NOT
  interchangeable (13 s. 3): 4-12 inside an object, 16 between the disc and its
  label, 24 between blocks, and 32 EXACTLY ONCE - after the hero, before the
  ledger. That single 32 is what makes the disc read as a hero and the rows read
  as a footer. A screen where every gap is 16 fails the squint test.

      [56]  header row: account                       layout_home_account.xml
      [ 1]  hairline, alpha 0 until the content scrolls
      [48]  inline status strip, only when a condition applies
      [24]
      [176] the connect object: one disc, one ring, one glyph
      [16]
      [>=42] status line
      [24]
      [>=44] numeric strip, INVISIBLE at rest and never GONE
      [32]
      [112 or gate] the two ledger rows, or the gate block. Never both
      [24]

  WHAT IS NOT HERE, AND WILL NOT COME BACK: the radial page gradient and the
  accent glow behind the shield (banned, 1.4.3), the 850ms breathing loop
  (banned, 8.1), the one-shot cold-start assemble (banned, 8.9), the up and down
  text arrows used as chrome (banned, 1.4.4), the debug memory card, «Приветствуем!»
  heading, the two weighted spacers that made the first-run layout depend on
  viewport height, the embedded de-virtualised server list inside this
  NestedScrollView, and the provider meta-bar carousel whose refresh / ping /
  collapse buttons acted on EVERY provider while sitting on one provider's card.
  Servers are a destination (11-app-structure 2.3); this screen holds a pointer.

  NO CARD ON THIS SCREEN. The disc is a FrameLayout with a drawable, not a
  MaterialCardView: a card is an object with a boundary, and this is a control.

  ZERO RAW VALUES. No dp, no sp, no hex, no fontFamily, no textSize anywhere in
  this file - every number is a token and every text element carries only a
  textAppearance (W-11).

  clipChildren / clipToPadding are false the whole way down because the confirm
  ring scales to 1.35 (238dp) and has to paint outside the 176dp frame (13 s. 5.4).
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/home_tab_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/home_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_24">

        <!-- Rows bleed to the screen edge so their press feedback does; each row
             carries the 16dp gutter itself, from @style/Widget.Departament.Row. -->
        <include
            android:id="@+id/layout_home_account"
            layout="@layout/layout_home_account" />

        <!-- The ONLY scroll-linked change on this screen: no colour step, no
             elevation, no shadow, no collapsing title (00-rules.md 4.8). -->
        <View
            android:id="@+id/header_hairline"
            android:layout_width="match_parent"
            android:layout_height="@dimen/stroke_hairline"
            android:alpha="0"
            android:background="?attr/colorOutlineVariant"
            android:importantForAccessibility="no" />

        <!-- The shared status-strip component in its INLINE placement (S-6): a
             persistent CONDITION, no auto-dismiss. Its hairline is hidden and its
             bar is clipped to @dimen/radius_control from HomeFragment, which is the
             only difference from the shell's docked placement of the same file. -->
        <include
            android:id="@+id/layout_status_strip"
            layout="@layout/view_status_strip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_gutter"
            android:layout_marginTop="@dimen/space_12"
            android:layout_marginEnd="@dimen/screen_gutter" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_24" />

        <!--
          THE CONNECT OBJECT (13 s. 5). One disc, one ring, one glyph. Three states
          carried by COLOUR on a geometry that never changes.

          The frame IS the control: 176dp, which is both the disc and the touch
          target, so any thumb that reaches the lower half of the screen reaches it.
          Its background (the P3 disc fill plus the 3dp ring) and its foreground (the
          bounded ripple and the 2dp focus ring) are built in HomeFragment from theme
          attributes - a drawable file cannot carry a runtime-tinted stroke without
          the raw hex the old bg_connect_ring.xml shipped.

          Press is @anim/press_scale: 0.97 in 90ms, out in 160ms, and it scales the
          disc, the ring and the shield as ONE object because they are one control.
        -->
        <FrameLayout
            android:id="@+id/connect_frame"
            android:layout_width="@dimen/connect_disc"
            android:layout_height="@dimen/connect_disc"
            android:layout_gravity="center_horizontal"
            android:clickable="true"
            android:clipChildren="false"
            android:focusable="true"
            android:stateListAnimator="@anim/press_scale"
            tools:ignore="ContentDescription">

            <!-- The confirm ring. Emitted exactly ONCE, at the instant the tunnel
                 confirms, and by no other event in the product. Never loops, and
                 there is never a second ring. -->
            <View
                android:id="@+id/connect_ring_pulse"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:visibility="invisible" />

            <!-- The negotiating sweep. indicatorSize == the disc, so the arc travels
                 the ring itself instead of orbiting outside it, at the ring's own
                 stroke width; the static ring underneath IS the track. It runs ONLY
                 while the core is negotiating (13 s. 5.3). -->
            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/connect_sweep"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:indeterminate="true"
                android:visibility="gone"
                app:hideAnimationBehavior="inward"
                app:indeterminateAnimationType="disjoint"
                app:indicatorColor="?attr/colorPrimary"
                app:indicatorSize="@dimen/connect_disc"
                app:showAnimationBehavior="inward"
                app:trackColor="@android:color/transparent"
                app:trackCornerRadius="@dimen/stroke_emphasis"
                app:trackThickness="@dimen/stroke_ring" />

            <!-- Two shields, crossfaded. Never tint-animated: the filled shield is
                 accent from frame zero and only its alpha moves. -->
            <ImageView
                android:id="@+id/shield_outline"
                android:layout_width="@dimen/shield_glyph"
                android:layout_height="@dimen/shield_glyph"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ic_shield_outline"
                app:tint="?attr/colorOnSurfaceVariant" />

            <ImageView
                android:id="@+id/shield_filled"
                android:layout_width="@dimen/shield_glyph"
                android:layout_height="@dimen/shield_glyph"
                android:layout_gravity="center"
                android:alpha="0"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ic_shield_filled"
                app:tint="?attr/colorPrimary" />
        </FrameLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_16" />

        <!-- THE STATUS LINE (13 s. 6). This and an empty state are the only centred
             text in the product. There is NO status dot: the word carries the state
             and its colour reinforces it, which is already two channels (S-1). The
             word is swapped instantly, never crossfaded - it is the one string that
             has to be legible in four seconds. -->
        <LinearLayout
            android:id="@+id/status_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_gutter"
            android:paddingEnd="@dimen/screen_gutter">

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/home_status_disconnected"
                android:textAppearance="@style/TextAppearance.App.Title" />

            <!-- INVISIBLE, never GONE: its line is always reserved, so the numeric
                 strip below it never moves when the detail appears or goes. -->
            <TextView
                android:id="@+id/tv_status_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_24"
                android:layout_marginTop="@dimen/space_4"
                android:layout_marginEnd="@dimen/space_24"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.App.Subtitle"
                tools:text="Нидерланды, Амстердам" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_24" />

        <!--
          THE NUMERIC STRIP (13 s. 7). Three equal columns, the only place on this
          screen where the brand face sets anything.

          THE UNIT LIVES IN THE LABEL so the value stays a pure figure and the
          tabular advance has nothing else on the line to fight.

          THE RESERVE IS THE WHOLE POINT: android:minEms reserves N em, and an em IS
          the text size, so the reserve scales with the type at every font scale
          without a single sp literal. 3 em at the value's 16sp is the 48sp the spec
          asks for; 2 em is its 32sp. A value going 9,9 -> 10,1 or 48 -> 183 moves
          nothing.

          It is INVISIBLE and never GONE, and it is visible only while CONNECTED -
          never while negotiating, where the throughput is genuinely zero and
          printing 0,0 would be a placeholder pretending to be a reading.

          No arrow glyphs (the label already names the column) and no dividers
          between the columns: space separates them.
        -->
        <LinearLayout
            android:id="@+id/numeric_strip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_gutter"
            android:layout_marginEnd="@dimen/screen_gutter"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:visibility="invisible"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_down"
                    style="@style/TextAppearance.App.Numeric"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minEms="3"
                    android:textAppearance="@style/TextAppearance.App.Title"
                    tools:text="24,8" />

                <TextView
                    android:id="@+id/tv_down_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="@string/home_strip_down_label"
                    android:textAppearance="@style/TextAppearance.App.Caption" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_up"
                    style="@style/TextAppearance.App.Numeric"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minEms="3"
                    android:textAppearance="@style/TextAppearance.App.Title"
                    tools:text="3,1" />

                <TextView
                    android:id="@+id/tv_up_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="@string/home_strip_up_label"
                    android:textAppearance="@style/TextAppearance.App.Caption" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Empty in a box of reserved width until the first probe lands,
                     then faded in over motion_state. Never a dash, never a zero,
                     never a spinner. -->
                <TextView
                    android:id="@+id/tv_ping"
                    style="@style/TextAppearance.App.Numeric"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minEms="2"
                    android:textAppearance="@style/TextAppearance.App.Title"
                    tools:text="48" />

                <TextView
                    android:id="@+id/tv_ping_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="@string/home_strip_ping_label"
                    android:textAppearance="@style/TextAppearance.App.Caption" />
            </LinearLayout>
        </LinearLayout>

        <!-- THE ONE 32 ON THIS SCREEN. -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_32" />

        <!--
          THE LEDGER SLOT. Two universal rows, or the gate block, never both
          (13 s. 8.3). Both occupy this slot and HomeFragment crossfades between them
          in place.

          No section header: two rows are not a group that needs naming.

          «Серверы» answers "where do servers come from and how many are there",
          which nothing else on the screen answers - deliberately NOT the current
          server name, which is already 100dp above it.
        -->
        <LinearLayout
            android:id="@+id/ledger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include
                android:id="@+id/row_servers"
                layout="@layout/view_row" />

            <!-- Starts at the 68dp text origin and runs to the screen edge. -->
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke_hairline"
                android:layout_marginStart="@dimen/divider_inset_start"
                android:background="?attr/colorOutlineVariant"
                android:importantForAccessibility="no" />

            <FrameLayout
                android:id="@+id/subscription_slot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <include
                    android:id="@+id/row_subscription"
                    layout="@layout/view_row" />

                <!-- The silhouette of the row above it: two bars at the 68 origin,
                     at the title's and the subtitle's own heights. Static until
                     SkeletonBinder pulses it, and never a spinner. -->
                <LinearLayout
                    android:id="@+id/subscription_skeleton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/colorBackground"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/row_min_height"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/divider_inset_start"
                    android:paddingTop="@dimen/space_12"
                    android:paddingEnd="@dimen/screen_gutter"
                    android:paddingBottom="@dimen/space_12"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <View
                            style="@style/Widget.Departament.Skeleton.Bar"
                            android:layout_width="0dp"
                            android:layout_weight="3" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="@dimen/glyph_16"
                            android:layout_weight="7" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:orientation="horizontal">

                        <View
                            style="@style/Widget.Departament.Skeleton.Bar"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/space_12"
                            android:layout_weight="6" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="@dimen/space_12"
                            android:layout_weight="4" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- Offline: account-dependent rows keep their last value and say so
                 (00-rules.md 9.6). GONE unless the data on screen is known stale. -->
            <TextView
                android:id="@+id/tv_stale_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_gutter"
                android:layout_marginTop="@dimen/space_8"
                android:layout_marginEnd="@dimen/screen_gutter"
                android:text="@string/home_stale_hint"
                android:textAppearance="@style/TextAppearance.App.Caption"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <include
            android:id="@+id/layout_gate"
            layout="@layout/layout_home_empty" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
