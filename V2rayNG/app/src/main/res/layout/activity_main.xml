<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_gradient"
    android:orientation="vertical">

        <!-- Edge-to-edge: the gradient (home_root) draws behind the status bar; the
             app bar receives a top inset pad at runtime so the toolbar clears the clock. -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appbar_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            app:elevation="0dp">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:titleTextAppearance="@style/ToolbarBrandTitle" />

        </com.google.android.material.appbar.AppBarLayout>

        <!-- Content + overlaid bottom nav: the nav floats over the content so the
             server list scrolls UNDER a faint scrim rather than sitting on a solid bar. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <FrameLayout
                android:id="@+id/main_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

            <!-- ==================== HOME TAB ==================== -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/group_home"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                <!-- Brand wordmark: sits on the page background (no fill), left-aligned, and
                     scrolls away with the content (Incy-style). Space Grotesk @ wght 600. -->
                <TextView
                    android:id="@+id/tv_brand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/spacegrotesk"
                    android:fontVariationSettings="'wght' 600"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.02"
                    android:paddingStart="20dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="2dp"
                    android:text="@string/app_name"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="30sp"
                    tools:ignore="UnusedAttribute" />

                <!-- Home account header: sign-in button (signed out) / account chip (signed in) -->
                <include
                    android:id="@+id/layout_home_account"
                    layout="@layout/layout_home_account"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <!-- Inline stats: upload · uptime · download -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="6dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="↑"
                            android:textColor="@color/color_upload"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_upload_speed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/speed_zero"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_connection_time"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="00:00:00"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="↓"
                            android:textColor="@color/color_download"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_download_speed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/speed_zero"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_hero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="4dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="0dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingStart="20dp"
                        android:paddingTop="28dp"
                        android:paddingEnd="20dp"
                        android:paddingBottom="24dp">

                        <FrameLayout
                            android:layout_width="230dp"
                            android:layout_height="230dp"
                            android:layout_gravity="center">

                            <View
                                android:id="@+id/view_connect_glow"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_connect_glow"
                                android:visibility="invisible" />

                            <View
                                android:id="@+id/view_connect_ring"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_connect_ring" />

                            <!-- Thin rotating arc that sweeps around the ring while
                                 connecting (and while a subscription is loading). No solid
                                 fill: an indeterminate Material sweep. Its colour is pinned at
                                 runtime to the connecting accent so it matches the shield; the
                                 grow-in/shrink-out behaviours give a smooth start/stop. -->
                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:id="@+id/progress_connect"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:indeterminate="true"
                                android:visibility="gone"
                                app:hideAnimationBehavior="inward"
                                app:indeterminateAnimationType="disjoint"
                                app:indicatorColor="?attr/colorPrimary"
                                app:indicatorSize="212dp"
                                app:showAnimationBehavior="inward"
                                app:trackColor="@android:color/transparent"
                                app:trackCornerRadius="4dp"
                                app:trackThickness="3dp" />

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/card_connect"
                                android:layout_width="176dp"
                                android:layout_height="176dp"
                                android:layout_gravity="center"
                                android:clickable="true"
                                android:contentDescription="@string/tasker_start_service"
                                android:focusable="true"
                                app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                                app:cardCornerRadius="88dp"
                                app:cardElevation="0dp"
                                app:cardForegroundColor="@android:color/transparent"
                                app:rippleColor="@android:color/transparent"
                                app:strokeWidth="0dp">

                                <ImageView
                                    android:id="@+id/img_connect"
                                    android:layout_width="80dp"
                                    android:layout_height="80dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    app:srcCompat="@drawable/ic_shield_outline"
                                    app:tint="?attr/colorOnSurfaceVariant" />

                            </com.google.android.material.card.MaterialCardView>

                        </FrameLayout>

                        <!-- Label under the shield shows the selected/connected server name.
                             Connection STATE is conveyed by the shield/ring colour, not by text. -->
                        <TextView
                            android:id="@+id/tv_connection_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:layout_marginStart="24dp"
                            android:layout_marginEnd="24dp"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:letterSpacing="0.01"
                            android:maxLines="1"
                            android:text="@string/title_file_chooser"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="19sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- App memory usage card (Incy-style) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_memory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="18dp"
                        android:paddingTop="14dp"
                        android:paddingEnd="18dp"
                        android:paddingBottom="14dp">

                        <View
                            android:id="@+id/dot_memory"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/bg_status_dot" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/memory_app_usage"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tv_memory"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                tools:text="25 MB · Normal" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Empty state (no servers/subscriptions yet): two Incy add buttons. -->
                <include
                    android:id="@+id/layout_home_empty"
                    layout="@layout/layout_home_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <!-- Current provider meta bar (collapsible), reused from the subscription header -->
                <include
                    android:id="@+id/layout_home_meta_bar"
                    layout="@layout/layout_subscription_meta_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <!-- Server list right here, below the provider -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_home_servers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:paddingBottom="12dp" />

                </LinearLayout>

            </androidx.core.widget.NestedScrollView>

            <!-- ==================== SERVERS TAB ==================== -->
            <LinearLayout
                android:id="@+id/group_servers"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <include
                    android:id="@+id/layout_servers_header"
                    layout="@layout/layout_servers_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_servers"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:scrollbars="vertical" />

                    <include
                        android:id="@+id/layout_empty"
                        layout="@layout/layout_servers_empty"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone" />

                </FrameLayout>

            </LinearLayout>

            <!-- ==================== SETTINGS TAB ==================== -->
            <include
                android:id="@+id/group_settings"
                layout="@layout/layout_settings_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            </FrameLayout>

            <!-- Faint gradient scrim (transparent -> surface): the content fades out
                 under the nav buttons so the bar reads as frameless, no solid fill. -->
            <View
                android:id="@+id/bottom_nav_scrim"
                android:layout_width="match_parent"
                android:layout_height="128dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_bottom_nav_scrim" />

            <!-- Overlays the content and hugs the very bottom edge. wrap_content gives each item
                 room for BOTH the icon AND its label (a fixed short height clipped the labels);
                 a SMALL fixed bottom pad is applied at runtime (not the full gesture-bar inset)
                 so the bar sits low, just a few dp above the very bottom edge. -->
            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/bottom_nav"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="@android:color/transparent"
                app:elevation="0dp"
                app:itemActiveIndicatorStyle="@null"
                app:itemIconSize="24dp"
                app:itemIconTint="@color/bottom_nav_item_color"
                app:itemRippleColor="@android:color/transparent"
                app:itemTextAppearanceActive="@style/BottomNavLabel"
                app:itemTextAppearanceInactive="@style/BottomNavLabel"
                app:itemTextColor="@color/bottom_nav_item_color"
                app:labelVisibilityMode="labeled"
                app:menu="@menu/menu_bottom_nav" />

        </FrameLayout>

</LinearLayout>
