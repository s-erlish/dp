<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_gradient"
    android:orientation="vertical">

        <!-- Edge-to-edge: the gradient (home_root) draws behind the status bar; the
             app bar receives a top inset pad at runtime so the toolbar clears the clock. -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appbar_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            app:elevation="0dp">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:titleTextAppearance="@style/ToolbarBrandTitle" />

        </com.google.android.material.appbar.AppBarLayout>

        <!-- Content + overlaid bottom nav: the nav floats over the content so the
             server list scrolls UNDER a faint scrim rather than sitting on a solid bar. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <FrameLayout
                android:id="@+id/main_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

            <!-- ==================== HOME TAB ==================== -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/group_home"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                <!-- Home scrolling header (Incy-style): inline stats on the SAME top line as the
                     top-RIGHT "+" add action; both scroll away with the content. No brand wordmark.
                     The fixed toolbar is hidden on all tabs; the top status-bar inset is applied to
                     this scroll content at runtime so the row starts just below the clock. -->
                <LinearLayout
                    android:id="@+id/home_stats_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/screen_gutter"
                    android:paddingTop="@dimen/space_4"
                    android:paddingEnd="@dimen/screen_gutter"
                    android:paddingBottom="@dimen/space_4">

                    <!-- Invisible left spacer matching the top-right "+" button width (42dp) so the
                         3-weight stats block is centered between two equal edges -> the middle
                         column (tv_connection_time) lands at the real screen center. -->
                    <View
                        android:layout_width="42dp"
                        android:layout_height="1dp"
                        android:importantForAccessibility="no"
                        android:visibility="invisible" />

                    <!-- Inline stats block: upload · uptime · download (takes all remaining width) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="↑"
                                android:textAppearance="@style/TextAppearance.App.Caption"
                                android:textColor="?attr/colorPrimary" />

                            <TextView
                                android:id="@+id/tv_upload_speed"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/speed_zero"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_connection_time"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:fontFamily="monospace"
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="00:00:00"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="↓"
                                android:textAppearance="@style/TextAppearance.App.Caption"
                                android:textColor="?attr/colorPrimary" />

                            <TextView
                                android:id="@+id/tv_download_speed"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/speed_zero"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                    </LinearLayout>

                    <!-- Scrolling "+" add action: opens the SAME add menu the toolbar used. -->
                    <ImageButton
                        android:id="@+id/btn_home_add"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/menu_item_add_config"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        app:srcCompat="@drawable/ic_add_24dp"
                        app:tint="?attr/colorOnSurface" />

                </LinearLayout>

                <!-- Home account header: sign-in button (signed out) / account chip (signed in) -->
                <include
                    android:id="@+id/layout_home_account"
                    layout="@layout/layout_home_account"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <!-- Signature connect block. A plain LinearLayout, not a wrapping card:
                     the shield/ring is the ONE hero element, everything else stays quiet
                     (impeccable: no nested/transparent cards). -->
                <LinearLayout
                    android:id="@+id/card_hero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/space_4"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/screen_gutter"
                    android:paddingTop="@dimen/space_24"
                    android:paddingEnd="@dimen/screen_gutter"
                    android:paddingBottom="@dimen/space_24">

                        <FrameLayout
                            android:layout_width="230dp"
                            android:layout_height="230dp"
                            android:layout_gravity="center">

                            <View
                                android:id="@+id/view_connect_glow"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_connect_glow"
                                android:visibility="invisible" />

                            <View
                                android:id="@+id/view_connect_ring"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_connect_ring" />

                            <!-- Thin rotating arc that sweeps around the ring while
                                 connecting (and while a subscription is loading). No solid
                                 fill: an indeterminate Material sweep. Its colour is pinned at
                                 runtime to the connecting accent so it matches the shield; the
                                 grow-in/shrink-out behaviours give a smooth start/stop. -->
                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:id="@+id/progress_connect"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:indeterminate="true"
                                android:visibility="gone"
                                app:hideAnimationBehavior="inward"
                                app:indeterminateAnimationType="disjoint"
                                app:indicatorColor="?attr/colorPrimary"
                                app:indicatorSize="212dp"
                                app:showAnimationBehavior="inward"
                                app:trackColor="@android:color/transparent"
                                app:trackCornerRadius="4dp"
                                app:trackThickness="3dp" />

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/card_connect"
                                android:layout_width="176dp"
                                android:layout_height="176dp"
                                android:layout_gravity="center"
                                android:clickable="true"
                                android:contentDescription="@string/tasker_start_service"
                                android:focusable="true"
                                app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                                app:cardCornerRadius="88dp"
                                app:cardElevation="0dp"
                                app:cardForegroundColor="@android:color/transparent"
                                app:rippleColor="@android:color/transparent"
                                app:strokeWidth="0dp">

                                <ImageView
                                    android:id="@+id/img_connect"
                                    android:layout_width="80dp"
                                    android:layout_height="80dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    app:srcCompat="@drawable/ic_shield_outline"
                                    app:tint="?attr/colorOnSurfaceVariant" />

                            </com.google.android.material.card.MaterialCardView>

                        </FrameLayout>

                        <!-- Label under the shield shows the selected/connected server name.
                             Connection STATE is conveyed by the shield/ring colour, not by text. -->
                        <TextView
                            android:id="@+id/tv_connection_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_16"
                            android:layout_marginStart="@dimen/space_24"
                            android:layout_marginEnd="@dimen/space_24"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="@string/title_file_chooser"
                            android:textAppearance="@style/TextAppearance.App.Title" />

                </LinearLayout>

                <!-- App memory usage card (Incy-style). Hidden by default so it never flashes on
                     first launch before updateMemoryCard() runs; shown only when PREF_SHOW_MEMORY. -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_memory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/screen_gutter"
                    android:layout_marginEnd="@dimen/screen_gutter"
                    android:layout_marginBottom="@dimen/space_12"
                    android:visibility="gone"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/space_16"
                        android:paddingTop="@dimen/space_12"
                        android:paddingEnd="@dimen/space_16"
                        android:paddingBottom="@dimen/space_12">

                        <View
                            android:id="@+id/dot_memory"
                            android:layout_width="@dimen/space_8"
                            android:layout_height="@dimen/space_8"
                            android:layout_marginEnd="@dimen/space_12"
                            android:background="@drawable/bg_status_dot" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/memory_app_usage"
                                android:textAppearance="@style/TextAppearance.App.Caption" />

                            <TextView
                                android:id="@+id/tv_memory"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_4"
                                android:textAppearance="@style/TextAppearance.App.Title"
                                tools:text="25 MB · Normal" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Onboarding centering: two equal-weight spacers bracket the welcome heading +
                     onboarding card. group_home is fillViewport, so the child LinearLayout is
                     stretched to the viewport; the visible spacers split the leftover height so the
                     block sits in the vertical middle. Both are GONE once servers exist, restoring
                     the normal top-aligned layout. -->
                <View
                    android:id="@+id/home_empty_spacer_top"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:visibility="gone" />

                <!-- Welcome heading (empty state only): bold brand-style greeting above the card. -->
                <TextView
                    android:id="@+id/tv_home_welcome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_24"
                    android:layout_marginEnd="@dimen/space_24"
                    android:layout_marginBottom="@dimen/space_12"
                    android:gravity="center"
                    android:text="@string/home_welcome_title"
                    android:textAppearance="@style/TextAppearance.App.Headline"
                    android:visibility="gone" />

                <!-- Empty state (no servers/subscriptions yet): two Incy add buttons. -->
                <include
                    android:id="@+id/layout_home_empty"
                    layout="@layout/layout_home_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <View
                    android:id="@+id/home_empty_spacer_bottom"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:visibility="gone" />

                <!-- Current provider meta bar (collapsible), reused from the subscription header -->
                <include
                    android:id="@+id/layout_home_meta_bar"
                    layout="@layout/layout_subscription_meta_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/screen_gutter"
                    android:layout_marginEnd="@dimen/screen_gutter" />

                <!-- Server list right here, below the provider -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_home_servers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:paddingBottom="@dimen/space_12" />

                </LinearLayout>

            </androidx.core.widget.NestedScrollView>

            <!-- ==================== SERVERS TAB ==================== -->
            <LinearLayout
                android:id="@+id/group_servers"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <include
                    android:id="@+id/layout_servers_header"
                    layout="@layout/layout_servers_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_servers"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:scrollbars="vertical" />

                    <include
                        android:id="@+id/layout_empty"
                        layout="@layout/layout_servers_empty"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone" />

                </FrameLayout>

            </LinearLayout>

            <!-- ==================== SETTINGS TAB ==================== -->
            <include
                android:id="@+id/group_settings"
                layout="@layout/layout_settings_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- ==================== ACCOUNT TAB ==================== -->
            <!-- Host for AccountFragment (attached lazily the first time the tab is opened). A
                 plain FrameLayout, not a FragmentContainerView, so the fragment is added manually
                 and the tab only exists while signed in. -->
            <FrameLayout
                android:id="@+id/group_account"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            </FrameLayout>

            <!-- Faint gradient scrim (transparent -> surface): the content fades out
                 under the nav buttons so the bar reads as frameless, no solid fill. -->
            <View
                android:id="@+id/bottom_nav_scrim"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_bottom_nav_scrim" />

            <!-- Custom bottom bar (replaces Material BottomNavigationView, which reserved tall
                 internal whitespace below the label and floated the items well above the edge).
                 A plain 3-item weighted row of icon+label hugs the very bottom; a SMALL fixed
                 bottom pad (~gesture bar only) is applied at runtime so it sits a few dp low.
                 The item container ids (nav_home/nav_servers/nav_settings) match the existing
                 R.id constants so showTab/tab selection is unchanged. -->
            <LinearLayout
                android:id="@+id/bottom_nav"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="@android:color/transparent"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/nav_home"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:stateListAnimator="@anim/nav_press">

                    <ImageView
                        android:id="@+id/nav_home_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_nav_home"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/nav_home_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/bottom_nav_home"
                        android:textAppearance="@style/BottomNavLabel"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/nav_servers"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:stateListAnimator="@anim/nav_press">

                    <ImageView
                        android:id="@+id/nav_servers_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_nav_servers"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/nav_servers_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/bottom_nav_servers"
                        android:textAppearance="@style/BottomNavLabel"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/nav_settings"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:stateListAnimator="@anim/nav_press">

                    <ImageView
                        android:id="@+id/nav_settings_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_nav_settings"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/nav_settings_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/bottom_nav_settings"
                        android:textAppearance="@style/BottomNavLabel"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

                <!-- 4th item: opens the Account screen. Shown only when signed in
                     (toggled at runtime); a weighted item so it collapses to zero
                     width while GONE and the 3 remaining items keep equal thirds. -->
                <LinearLayout
                    android:id="@+id/nav_account"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:stateListAnimator="@anim/nav_press"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/nav_account_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_nav_account"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/nav_account_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/bottom_nav_account"
                        android:textAppearance="@style/BottomNavLabel"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

            </LinearLayout>

        </FrameLayout>

</LinearLayout>
