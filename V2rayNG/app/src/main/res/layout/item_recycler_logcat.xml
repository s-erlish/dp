<?xml version="1.0" encoding="utf-8"?>
<!--
  One log line (A-35).

  The old row was two `TextAppearance.AppCompat.Small` TextViews in an 8dp box, both
  in the same tone, so the tag and the message were indistinguishable and the LEVEL -
  the only thing a user scans a log for - was not shown at all.

  Now: a meta line carrying the timestamp and the tag, a status chip on the lines that
  actually went wrong (three hues, no fourth - R12), and the message underneath at
  Caption on the full width. A chip on EVERY line would be the decoration §2.4.4 asks
  you to delete; a chip only where something failed is a signal.

  The row is pressable and long-pressable (long press copies the line), so it carries
  @drawable/bg_row like every other row in the product rather than
  ?attr/selectableItemBackground, which draws no focus state.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/log_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_row"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_gutter"
    android:paddingTop="@dimen/space_12"
    android:paddingEnd="@dimen/screen_gutter"
    android:paddingBottom="@dimen/space_12">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.chip.Chip
            android:id="@+id/log_level"
            style="@style/Widget.Departament.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_8"
            android:singleLine="true"
            android:visibility="gone"
            tools:text="Ошибка"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/log_tag"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.App.Caption"
            tools:text="14:23:01  ·  GoLog" />
    </LinearLayout>

    <TextView
        android:id="@+id/log_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:textAppearance="@style/TextAppearance.App.Caption"
        android:textColor="?attr/colorOnSurface"
        tools:text="failed to handle mux client connection: connection closed" />
</LinearLayout>
