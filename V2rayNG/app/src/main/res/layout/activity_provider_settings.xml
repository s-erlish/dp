<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  «Настройки подписок» (ProviderSettingsActivity) — handoff README §7.
  ============================================================================

  §7's table gives this screen four groups and this file draws exactly those four,
  in that order: «Обновление · При запуске · Сеть · Список серверов».

      кнопка назад → заголовок 24sp/700 → четыре карточки

  The header is @layout/view_sub_header, so the screen goes through setContentView
  and ToolbarBinder rather than BaseActivity.setContentViewWithToolbar and its 16sp
  MaterialToolbar title.

  EVERY ROW IS §6's «Строка» NOW:

      плитка 40dp r12 нейтральная, глиф 22dp   @style/Widget.Departament.Tile
      → 16dp → заголовок 14sp + подпись 12.5sp Body + Caption
      → 12dp → значение 13sp / переключатель   Subtitle / MaterialSwitch
      минимум 56dp, растёт с подписью          @style/Widget.Departament.Row

  What that replaces, line for line: `?attr/selectableItemBackground` (a ripple, and
  §1 bans the whole kind — it is @drawable/bg_row plus @anim/press_row 0.975 now),
  a 60dp fixed row height, 14dp inner padding, inline 16sp/12sp/13sp sizes, a 12dp
  card inset, a 68dp-inset hairline, and five colours of icon tile — blue, green,
  orange, yellow and purple — that encoded no category at all (D-5, §9).

  TWO ROWS OPEN THE SELECT POPUP, not a dialog: «Интервал обновления» and
  «Сортировка серверов» are two of the nine §6 names, so both carry the CARET
  (@drawable/ic_arrow_drop_down) instead of a chevron — a chevron promises a screen
  and neither row opens one — and both have a @id/caret_* the popup can turn 180°.
  «User-Agent» keeps its chevron and its dialog: it is free text, not a choice from
  a short list, and §6's popup has nothing to offer it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".ui.ProviderSettingsActivity">

    <include
        android:id="@+id/toolbar"
        layout="@layout/view_sub_header" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_32"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:orientation="vertical">

            <!-- ==================== ОБНОВЛЕНИЕ ==================== -->
            <TextView
                style="@style/SettingsSectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ps_section_update" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Departament.CardSection"
                android:clipChildren="false"
                android:clipToPadding="false">

                <LinearLayout
                    style="@style/Widget.Departament.CardSection.Body"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <!-- Автообновление. THE EDGE ROWS OF THIS CARD ROUND THEMSELVES: the card
                         hosts «Интервал обновления»'s select popup and therefore cannot clip its
                         children (§11 grabl 4), so it no longer trims its first and last row to
                         its own corner. 19dp, one pixel inside the card's 20dp stroke. -->
                    <LinearLayout
                        android:id="@+id/row_auto_update"
                        style="@style/Widget.Departament.Row"
                        android:background="@drawable/bg_row_top"
                        android:baselineAligned="false">

                        <ImageView
                            style="@style/Widget.Departament.Tile"
                            android:layout_marginEnd="@dimen/space_16"
                            android:importantForAccessibility="no"
                            app:srcCompat="@drawable/ic_refresh_24dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/space_12"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/ps_auto_update"
                                android:textAppearance="@style/TextAppearance.App.Body" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_4"
                                android:text="@string/ps_auto_update_sub"
                                android:textAppearance="@style/TextAppearance.App.Caption" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_auto_update"
                            style="@style/Widget.Departament.Switch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            android:focusable="false"
                            android:importantForAccessibility="no" />
                    </LinearLayout>

                    <com.google.android.material.divider.MaterialDivider
                        android:id="@+id/divider_interval"
                        style="@style/Widget.Departament.Divider.Full"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <!-- Интервал обновления — §6 «окошко у значения» -->
                    <LinearLayout
                        android:id="@+id/row_interval"
                        style="@style/Widget.Departament.Row"
                        android:baselineAligned="false">

                        <ImageView
                            style="@style/Widget.Departament.Tile"
                            android:layout_marginEnd="@dimen/space_16"
                            android:importantForAccessibility="no"
                            app:srcCompat="@drawable/ic_ps_clock" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/space_12"
                            android:layout_weight="1"
                            android:text="@string/ps_interval"
                            android:textAppearance="@style/TextAppearance.App.Body" />

                        <TextView
                            android:id="@+id/value_interval"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textAppearance="@style/TextAppearance.App.Subtitle"
                            tools:text="1 ч" />

                        <ImageView
                            android:id="@+id/caret_interval"
                            android:layout_width="@dimen/glyph_20"
                            android:layout_height="@dimen/glyph_20"
                            android:layout_marginStart="@dimen/space_4"
                            android:importantForAccessibility="no"
                            app:srcCompat="@drawable/ic_arrow_drop_down"
                            app:tint="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                    <com.google.android.material.divider.MaterialDivider
                        style="@style/Widget.Departament.Divider.Full"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <!-- Уведомлять об обновлениях -->
                    <LinearLayout
                        android:id="@+id/row_notify"
                        style="@style/Widget.Departament.Row"
                        android:background="@drawable/bg_row_bottom"
                        android:baselineAligned="false">

                        <ImageView
                            style="@style/Widget.Departament.Tile"
                            android:layout_marginEnd="@dimen/space_16"
                            android:importantForAccessibility="no"
                            app:srcCompat="@drawable/ic_ps_bell" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/space_12"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/ps_notify_updates"
                                android:textAppearance="@style/TextAppearance.App.Body" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_4"
                                android:text="@string/ps_notify_updates_sub"
                                android:textAppearance="@style/TextAppearance.App.Caption" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_notify"
                            style="@style/Widget.Departament.Switch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            android:focusable="false"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ==================== ПРИ ЗАПУСКЕ ==================== -->
            <TextView
                style="@style/SettingsSectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ps_section_startup" />

            <com.google.android.material.card.MaterialCardView style="@style/Widget.Departament.CardSection">

                <LinearLayout style="@style/Widget.Departament.CardSection.Body">

                    <!-- Обновлять подписки при запуске -->
                    <LinearLayout
                        android:id="@+id/row_update_on_launch"
                        style="@style/Widget.Departament.Row"
                        android:baselineAligned="false">

                        <ImageView
                            style="@style/Widget.Departament.Tile"
                            android:layout_marginEnd="@dimen/space_16"
                            android:importantForAccessibility="no"
                            app:srcCompat="@drawable/ic_power_settings" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/space_12"
                            android:layout_weight="1"
                            android:text="@string/ps_update_on_launch"
                            android:textAppearance="@style/TextAppearance.App.Body" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_update_on_launch"
                            style="@style/Widget.Departament.Switch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            android:focusable="false"
                            android:importantForAccessibility="no" />
                    </LinearLayout>

                    <com.google.android.material.divider.MaterialDivider
                        style="@style/Widget.Departament.Divider.Full"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <!-- Пинг серверов при запуске -->
                    <LinearLayout
                        android:id="@+id/row_ping_on_launch"
                        style="@style/Widget.Departament.Row"
                        android:baselineAligned="false">

                        <ImageView
                            style="@style/Widget.Departament.Tile"
                            android:layout_marginEnd="@dimen/space_16"
                            android:importantForAccessibility="no"
                            app:srcCompat="@drawable/ic_ping_24dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/space_12"
                            android:layout_weight="1"
                            android:text="@string/ps_ping_on_launch"
                            android:textAppearance="@style/TextAppearance.App.Body" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_ping_on_launch"
                            style="@style/Widget.Departament.Switch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            android:focusable="false"
                            android:importantForAccessibility="no" />
                    </LinearLayout>

                    <com.google.android.material.divider.MaterialDivider
                        style="@style/Widget.Departament.Divider.Full"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <!-- Пинг при обновлении -->
                    <LinearLayout
                        android:id="@+id/row_ping_on_update"
                        style="@style/Widget.Departament.Row"
                        android:baselineAligned="false">

                        <ImageView
                            style="@style/Widget.Departament.Tile"
                            android:layout_marginEnd="@dimen/space_16"
                            android:importantForAccessibility="no"
                            app:srcCompat="@drawable/ic_ping_24dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/space_12"
                            android:layout_weight="1"
                            android:text="@string/ps_ping_on_update"
                            android:textAppearance="@style/TextAppearance.App.Body" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_ping_on_update"
                            style="@style/Widget.Departament.Switch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            android:focusable="false"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ==================== СЕТЬ ==================== -->
            <TextView
                style="@style/SettingsSectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ps_section_network" />

            <com.google.android.material.card.MaterialCardView style="@style/Widget.Departament.CardSection">

                <LinearLayout style="@style/Widget.Departament.CardSection.Body">

                    <!-- Отправлять HWID -->
                    <LinearLayout
                        android:id="@+id/row_send_hwid"
                        style="@style/Widget.Departament.Row"
                        android:baselineAligned="false">

                        <ImageView
                            style="@style/Widget.Departament.Tile"
                            android:layout_marginEnd="@dimen/space_16"
                            android:importantForAccessibility="no"
                            app:srcCompat="@drawable/ic_ps_fingerprint" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/space_12"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/ps_send_hwid"
                                android:textAppearance="@style/TextAppearance.App.Body" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_4"
                                android:text="@string/ps_send_hwid_sub"
                                android:textAppearance="@style/TextAppearance.App.Caption" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_send_hwid"
                            style="@style/Widget.Departament.Switch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            android:focusable="false"
                            android:importantForAccessibility="no" />
                    </LinearLayout>

                    <com.google.android.material.divider.MaterialDivider
                        style="@style/Widget.Departament.Divider.Full"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <!-- User-Agent: свободный текст, поэтому диалог и шеврон, а не окошко -->
                    <LinearLayout
                        android:id="@+id/row_user_agent"
                        style="@style/Widget.Departament.Row"
                        android:baselineAligned="false">

                        <ImageView
                            style="@style/Widget.Departament.Tile"
                            android:layout_marginEnd="@dimen/space_16"
                            android:importantForAccessibility="no"
                            app:srcCompat="@drawable/ic_ps_tag" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/space_12"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/ps_user_agent"
                                android:textAppearance="@style/TextAppearance.App.Body" />

                            <!-- The value is the row's SUBTITLE and not its trailing text: a
                                 User-Agent is a long string, and squeezed into the trailing slot
                                 it ellipsised to «Mozilla/5.0…», which reports nothing. -->
                            <TextView
                                android:id="@+id/value_user_agent"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_4"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:textAppearance="@style/TextAppearance.App.Caption"
                                tools:text="departament/2.2.1" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="@dimen/glyph_20"
                            android:layout_height="@dimen/glyph_20"
                            android:importantForAccessibility="no"
                            app:srcCompat="@drawable/ic_chevron_right"
                            app:tint="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ==================== СПИСОК СЕРВЕРОВ ==================== -->
            <TextView
                style="@style/SettingsSectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ps_section_server_list" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Departament.CardSection"
                android:clipChildren="false"
                android:clipToPadding="false">

                <LinearLayout
                    style="@style/Widget.Departament.CardSection.Body"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <!-- Сортировка серверов — §6 «окошко у значения» -->
                    <!-- The card's only row, and the card cannot clip: all four corners here. -->
                    <LinearLayout
                        android:id="@+id/row_sort_order"
                        style="@style/Widget.Departament.Row"
                        android:background="@drawable/bg_row_only"
                        android:baselineAligned="false">

                        <ImageView
                            style="@style/Widget.Departament.Tile"
                            android:layout_marginEnd="@dimen/space_16"
                            android:importantForAccessibility="no"
                            app:srcCompat="@drawable/ic_ps_sort" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/space_12"
                            android:layout_weight="1"
                            android:text="@string/ps_sort_order"
                            android:textAppearance="@style/TextAppearance.App.Body" />

                        <TextView
                            android:id="@+id/value_sort_order"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textAppearance="@style/TextAppearance.App.Subtitle"
                            tools:text="По пингу" />

                        <ImageView
                            android:id="@+id/caret_sort_order"
                            android:layout_width="@dimen/glyph_20"
                            android:layout_height="@dimen/glyph_20"
                            android:layout_marginStart="@dimen/space_4"
                            android:importantForAccessibility="no"
                            app:srcCompat="@drawable/ic_arrow_drop_down"
                            app:tint="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
