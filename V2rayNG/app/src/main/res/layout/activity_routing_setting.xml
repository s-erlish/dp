<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  A-20  settings/routing - Маршрутизация.  H3 · R1.
  24-tab-conformance.md A-20, 00-rules.md 4.2 / 4.8.
  ============================================================================

  What changed, beyond the tokens: FIVE ACTIONS CAME OUT OF A TOOLBAR OVERFLOW that
  nothing else in the app has - «Готовые наборы», «Импорт из буфера», «Импорт из
  QR-кода», «Экспорт», and «Добавить правило» - and became visible rows in their own
  group. A-38 removes the ActionBar these lived on, so leaving them there would have
  deleted five features outright.

  The screen is one ledger, top to bottom (R1):

      H3 toolbar «Маршрутизация» + «Добавить правило»
      24 · Row.Value «Стратегия доменов», cycles AsIs / IPIfNonMatch / IPOnDemand
      24 · «Правила» · rule rows at 0, or the empty state
      24 · «Наборы и обмен» · four action rows
      32

  Deleted with the old file: the 12dp card inset, the 60dp row height, the 14dp inner
  padding, the 16sp/13sp inline sizes, the 18dp chevron and the purple icon tile - a
  fourth tile colour that encoded no category (D-5).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".ui.RoutingSettingActivity">

    <include
        android:id="@+id/toolbar"
        layout="@layout/view_toolbar" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_32"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView style="@style/Widget.Departament.CardSection">

                <LinearLayout style="@style/Widget.Departament.CardSection.Body">

                    <include
                        android:id="@+id/row_domain_strategy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        layout="@layout/view_row" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/label_rules"
                style="@style/SettingsSectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/routing_section_rules" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/view_row" />

            <include
                android:id="@+id/empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:layout_marginBottom="@dimen/space_24"
                layout="@layout/view_empty_state" />

            <TextView
                style="@style/SettingsSectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/routing_section_actions" />

            <com.google.android.material.card.MaterialCardView style="@style/Widget.Departament.CardSection">

                <LinearLayout style="@style/Widget.Departament.CardSection.Body">

                    <include
                        android:id="@+id/row_presets"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        layout="@layout/view_row" />

                    <include
                        android:id="@+id/row_import_clipboard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        layout="@layout/view_row" />

                    <include
                        android:id="@+id/row_import_qrcode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        layout="@layout/view_row" />

                    <include
                        android:id="@+id/row_export"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        layout="@layout/view_row" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
