<?xml version="1.0" encoding="utf-8"?>
<!-- Custom gray status toast: a single neutral pill. Replaces the old green/system-style
     service toasts. Text is set at runtime by MainActivity.showStatusToast(). -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tv_toast_status"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="24dp"
    android:layout_marginEnd="24dp"
    android:background="@drawable/bg_toast_status"
    android:gravity="center"
    android:letterSpacing="0.01"
    android:maxLines="1"
    android:paddingStart="22dp"
    android:paddingTop="12dp"
    android:paddingEnd="22dp"
    android:paddingBottom="12dp"
    android:textColor="?attr/colorOnSurface"
    android:textSize="14sp"
    android:textStyle="bold" />
