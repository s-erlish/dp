<?xml version="1.0" encoding="utf-8"?>
<!--
    The Серверы tab, hosted in the shell's fragment container (activity_main's @id/tab_host).

    Lifted out of activity_main.xml unchanged: the header (title actions + search), the grouped
    server list, and the empty state stacked over it. The container is padded with the status-bar
    inset on behalf of every tab it hosts, so this tree adds no top inset of its own; the list's
    bottom padding (which has to clear the overlaid bottom nav) is applied by ServersFragment from
    the shell's one inset strategy.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/servers_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include
        android:id="@+id/layout_servers_header"
        layout="@layout/layout_servers_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_servers"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:scrollbars="vertical" />

        <include
            android:id="@+id/layout_empty"
            layout="@layout/layout_servers_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
