<?xml version="1.0" encoding="utf-8"?>
<!--
  One subscription = one ViewPager2 page. It is a SIBLING of the profile card (same
  token recipe), never nested in another card. Incy: colorSurface, radius_card, 0
  elevation, 1dp outlineVariant stroke, space_16 padding, ONE blue accent (the tariff
  badge tile), sentence-case Russian, name + badge in the header, then expiry / devices.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="@dimen/radius_card"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="@dimen/stroke_hairline">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/space_16">

        <!-- Header: subscription name (left, truncates) + tariff badge (right) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_sub_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.App.Title"
                tools:text="Premium" />

            <TextView
                android:id="@+id/tv_tariff_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8"
                android:background="@drawable/bg_acc_badge"
                android:paddingHorizontal="@dimen/space_8"
                android:paddingVertical="@dimen/space_4"
                android:textAppearance="@style/TextAppearance.App.Chip"
                android:textColor="?attr/colorPrimary"
                android:visibility="gone"
                tools:ignore="HardcodedText"
                tools:text="Base"
                tools:visibility="visible" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_sub_expiry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:textAppearance="@style/TextAppearance.App.Subtitle"
            tools:text="Действует до 31.12.2026" />

        <!-- THE TRAFFIC METER. The desktop's TrafficPill, expressed as this app's own meter
             component: label beside the bar, never printed on it. On an unlimited plan the bar
             is hidden and the value reads «1,9 ТБ · безлимит» — a bar with no ceiling is a lie
             — and with no usage figure at all the whole meter goes rather than drawing 0 of 0. -->
        <include
            android:id="@+id/meter_traffic"
            layout="@layout/view_meter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12" />

        <!-- DEVICES, INSIDE THE CARD, AND TAPPABLE. The desktop makes the whole «Устройства»
             measure a tap target onto the devices screen (MeterRow, «ВСЯ строка»); Android had
             the figure as dead text and the only route to the screen was the hub row further
             down. Both stay: this is a second door on the card that owns the allowance. -->
        <LinearLayout
            android:id="@+id/row_sub_devices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="@dimen/row_min_height"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_sub_devices"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFeatureSettings="&quot;tnum&quot; on"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.App.Subtitle"
                tools:text="Устройства: 1 / 3" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="@dimen/space_8"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ic_chevron_right"
                app:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <!-- «ПРОДЛИТЬ» — the card's ONE primary action, full width, and it is shown on a
             perpetual подписка too. The owner is explicit: «она должна быть и при бессрочной
             подписке». A perpetual plan is the one a user is most likely to extend deliberately,
             and hiding the control tells him the account cannot be topped up at all. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_sub_renew"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:text="@string/account_sub_renew" />

        <!-- AUTO-RENEW: the toggle and the line that says what it will do next. Mirrors the
             desktop's ShowAutoRenew block. Hidden only when the backend gives us no subscription
             id to act on — a switch that cannot be honoured must not be offered. -->
        <LinearLayout
            android:id="@+id/row_sub_autorenew"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:gravity="center_vertical"
            android:minHeight="@dimen/row_min_height"
            android:orientation="horizontal">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_sub_autorenew"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/account_sub_autorenew" />

            <TextView
                android:id="@+id/tv_sub_autorenew"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_12"
                android:layout_weight="1"
                android:text="@string/account_sub_autorenew"
                android:textAppearance="@style/TextAppearance.App.Subtitle" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
