<?xml version="1.0" encoding="utf-8"?>
<!--
  One subscription = one ViewPager2 page. It is a SIBLING of the profile card (same
  token recipe), never nested in another card. Incy: colorSurface, radius_card, 0
  elevation, 1dp outlineVariant stroke, space_16 padding, ONE blue accent (the tariff
  badge tile), sentence-case Russian, name + badge in the header, then expiry / devices.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="@dimen/radius_card"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="@dimen/stroke_hairline">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/space_16">

        <!-- Header: subscription name (left, truncates) + tariff badge (right) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_sub_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.App.Title"
                tools:text="Premium" />

            <TextView
                android:id="@+id/tv_tariff_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8"
                android:background="@drawable/bg_acc_badge"
                android:paddingHorizontal="@dimen/space_8"
                android:paddingVertical="@dimen/space_4"
                android:textAppearance="@style/TextAppearance.App.Chip"
                android:textColor="?attr/colorPrimary"
                android:visibility="gone"
                tools:ignore="HardcodedText"
                tools:text="Base"
                tools:visibility="visible" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_sub_expiry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:textAppearance="@style/TextAppearance.App.Subtitle"
            tools:text="Действует до 31.12.2026" />

        <TextView
            android:id="@+id/tv_sub_devices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:fontFeatureSettings="&quot;tnum&quot; on"
            android:textAppearance="@style/TextAppearance.App.Subtitle"
            tools:text="Устройства: 1 / 3" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
