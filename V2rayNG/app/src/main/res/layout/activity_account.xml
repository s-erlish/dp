<?xml version="1.0" encoding="utf-8"?>
<!--
  Account HUB, hosted in-place as the Account bottom-nav tab.
  Two zones only: a cohesive HERO (profile card + subscription carousel, read as one
  unit) and a single "Управление" management list. Incy language: pure dark, ONE blue
  accent, brand type, token spacing/radii/tiles, sentence-case Russian, 0 elevation,
  1dp colorOutlineVariant stroke, no nested cards, no gradients. Every state present:
  skeleton (loading), empty, carousel (active), error.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_gutter"
        android:paddingTop="@dimen/space_12"
        android:paddingBottom="@dimen/space_24">

        <!-- ============ HERO zone: profile card + subscription state ============ -->

        <!-- Profile card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="@dimen/radius_card"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_16">

                <!-- Row 1: avatar + handle + top-up pill -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/avatar_container"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:clickable="true"
                        android:contentDescription="@string/account_change_avatar"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless">

                        <View
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_avatar_circle" />

                        <TextView
                            android:id="@+id/tv_avatar_initial"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:text="?"
                            android:textColor="?attr/iconTintBlue"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            tools:ignore="HardcodedText" />

                        <ImageView
                            android:id="@+id/img_avatar"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:scaleType="centerCrop"
                            android:visibility="gone" />

                        <ImageView
                            android:id="@+id/img_avatar_edit"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="bottom|end"
                            android:background="@drawable/bg_avatar_edit"
                            android:importantForAccessibility="no"
                            android:padding="@dimen/space_4"
                            app:srcCompat="@drawable/ic_acc_camera" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tv_username"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.App.Title"
                        tools:text="Erlish" />

                    <!-- No style attribute on purpose: themes.xml binds materialButtonStyle to
                         Widget.Departament.Button.Primary, so this control inherits the modelled
                         fill and the press motion the owner asked for (OWNER-FEEDBACK D1) instead
                         of a flat slab, plus btn_height 48, radius_button 16, Title type and
                         glyph_20 — every one of which was previously overridden inline.
                         android:minHeight="0dp" with 8dp vertical padding made this a ~36dp
                         target, under the 48dp floor; only the horizontal padding is trimmed now,
                         which keeps it compact beside the account name without shrinking the hit
                         box. -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_top_up"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:minWidth="0dp"
                        android:paddingStart="@dimen/space_16"
                        android:paddingEnd="@dimen/space_16"
                        android:text="@string/account_top_up"
                        app:icon="@drawable/ic_add_24dp" />
                </LinearLayout>

                <!-- ============ The hero figure is TIME, not money ============
                     23-account-rework.md 1.2: the user opens this tab because the подписка is
                     running out, not because of the wallet. So the ONE Display figure on the
                     screen is the expiry, and its silhouette is CONSTANT — label, figure + word,
                     optional detail — with colour carrying health (onSurface / amber / red), so
                     the card never changes shape as the account's state changes.

                     Perpetual and unknown-expiry have no date to set: the figure hides and
                     tv_time_word carries the Title line with tv_time_detail beneath it. Those are
                     the only two states in which this tab shows zero Display figures. -->
                <LinearLayout
                    android:id="@+id/ll_time_block"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/tv_time_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.App.Subtitle"
                        tools:text="Активна до" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:baselineAligned="true"
                        android:orientation="horizontal">

                        <!-- THE GAP BELONGS TO THE FIGURE, NOT TO THE WORD, and that is the fix
                             for «слово бессрочная подписка уехала вправо». In the perpetual and
                             unknown states `renderTimeLines` hides the figure and the word carries
                             the Title line alone — but the word used to own the 8dp gap, so with
                             the figure gone it still started 8dp in, while «Баланс» and the
                             ref-code below it sat on the card's gutter. Hanging the gap off the
                             figure's END makes it disappear with the figure, so the word lands on
                             the same gutter as every other line in this card. -->
                        <TextView
                            android:id="@+id/tv_time_figure"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/space_8"
                            android:textAppearance="@style/TextAppearance.App.Numeric.Display"
                            tools:text="3" />

                        <TextView
                            android:id="@+id/tv_time_word"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textAppearance="@style/TextAppearance.App.Title"
                            tools:text="августа" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_time_detail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:textAppearance="@style/TextAppearance.App.Subtitle"
                        android:visibility="gone"
                        tools:text="Осталось 24 дня"
                        tools:visibility="visible" />
                </LinearLayout>

                <!-- Balance: demoted from the 34sp hero to a labelled value (1.2, 1.3). It is
                     still the count-up figure it always was — «Пополнить» above it is the action,
                     so this line states and does not duplicate the CTA.

                     Starts gone and is revealed by renderProfile: a label with no figure beside it
                     reads as a broken value, so the row appears with its number or not at all. -->
                <LinearLayout
                    android:id="@+id/row_balance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:baselineAligned="true"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/account_balance"
                        android:textAppearance="@style/TextAppearance.App.Subtitle" />

                    <TextView
                        android:id="@+id/tv_balance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.App.Numeric.Money"
                        android:textSize="16sp"
                        tools:text="1 500 ₽" />
                </LinearLayout>

                <!-- Referral: whole row taps to copy; code reads on a quiet chip, copy is the trailing glyph -->
                <LinearLayout
                    android:id="@+id/row_referral"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:clickable="true"
                    android:contentDescription="@string/account_copy_referral"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_referral"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_acc_chip"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:paddingHorizontal="@dimen/space_12"
                        android:paddingVertical="@dimen/space_8"
                        android:textAppearance="@style/TextAppearance.App.Caption"
                        tools:text="Реф-код ABC123" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="@dimen/space_8"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_copy"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Payment-processing hint (shown while re-polling after a checkout) -->
        <TextView
            android:id="@+id/tv_pending"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:background="@drawable/bg_acc_chip"
            android:padding="@dimen/space_12"
            android:text="@string/account_payment_pending"
            android:textAppearance="@style/TextAppearance.App.Body"
            android:visibility="gone" />

        <!-- Subscription state slot: four mutually-exclusive children, toggled by the Kotlin WP.
             Tight space_12 gap keeps it reading as one unit with the profile card above. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12">

            <!-- (a) Loading skeleton: a sub-card-shaped silhouette; Kotlin pulses its alpha -->
            <LinearLayout
                android:id="@+id/group_sub_skeleton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/sub_card_height"
                android:background="@drawable/bg_skeleton"
                android:orientation="vertical"
                android:padding="@dimen/space_16">

                <View
                    android:layout_width="140dp"
                    android:layout_height="18dp"
                    android:background="?attr/colorOutlineVariant" />

                <View
                    android:layout_width="200dp"
                    android:layout_height="14dp"
                    android:layout_marginTop="@dimen/space_16"
                    android:background="?attr/colorOutlineVariant" />

                <View
                    android:layout_width="120dp"
                    android:layout_height="14dp"
                    android:layout_marginTop="@dimen/space_8"
                    android:background="?attr/colorOutlineVariant" />
            </LinearLayout>

            <!-- (b) Empty state: card-shaped onboarding block (sibling card, not nested) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/group_sub_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <TextView
                        android:id="@+id/tv_empty_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/account_empty_title"
                        android:textAppearance="@style/TextAppearance.App.Title" />

                    <TextView
                        android:id="@+id/tv_empty_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="@string/account_no_subscription"
                        android:textAppearance="@style/TextAppearance.App.Body"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <!-- Theme default = Widget.Departament.Button.Primary. The inline overrides it
                         used to carry (textAllCaps, textStyle, cornerRadius, iconSize, iconGravity)
                         restated the style's own tokens at a different icon size; dropped so the
                         empty-state CTA is the same object as every other primary in the app. -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_buy_first"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_16"
                        android:text="@string/account_hub_buy"
                        app:icon="@drawable/ic_acc_upgrade" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- (c) Active state: subscription carousel + page dots -->
            <LinearLayout
                android:id="@+id/group_sub_carousel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/vp_subscriptions"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/sub_card_height"
                    android:clipToPadding="false" />

                <LinearLayout
                    android:id="@+id/ll_sub_dots"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/space_12"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>

            <!-- (d) Error state: card-shaped block with retry -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/group_account_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <TextView
                        android:id="@+id/tv_error_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/account_error_load_title"
                        android:textAppearance="@style/TextAppearance.App.Title" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="@string/account_error_generic"
                        android:textAppearance="@style/TextAppearance.App.Body"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <!-- Secondary, not a raw M3 tonal button: the app's own tier carries the bevel,
                         the press motion, the focus ring and btn_height 48 that a bare
                         Widget.Material3.Button.TonalButton has none of (OWNER-FEEDBACK D1). -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_retry_load"
                        style="@style/Widget.Departament.Button.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_16"
                        android:text="@string/account_retry" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>

        <!-- ============ Management zone: the ONE section header on the screen ============ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:layout_marginBottom="@dimen/space_8"
            android:text="@string/account_manage_title"
            android:textAppearance="@style/TextAppearance.App.Title" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="@dimen/radius_card"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Купить подписку (promoted) -->
                <LinearLayout
                    android:id="@+id/row_buy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/row_min_height"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/screen_gutter"
                    android:paddingEnd="@dimen/screen_gutter"
                    android:paddingVertical="@dimen/space_8">

                    <FrameLayout
                        android:layout_width="@dimen/tile_size"
                        android:layout_height="@dimen/tile_size"
                        android:background="@drawable/bg_icon_blue">

                        <ImageView
                            android:layout_width="@dimen/tile_glyph"
                            android:layout_height="@dimen/tile_glyph"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            app:srcCompat="@drawable/ic_acc_upgrade"
                            app:tint="?attr/iconTintBlue" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_marginEnd="@dimen/space_8"
                        android:layout_weight="1"
                        android:text="@string/account_hub_buy"
                        android:textAppearance="@style/TextAppearance.App.Title"
                        android:textColor="?attr/colorPrimary" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="@dimen/space_4"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_chevron_right"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="@dimen/divider_inset_start"
                    android:background="?attr/colorOutlineVariant" />

                <!-- Устройства -->
                <LinearLayout
                    android:id="@+id/row_devices"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/row_min_height"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/screen_gutter"
                    android:paddingEnd="@dimen/screen_gutter"
                    android:paddingVertical="@dimen/space_8">

                    <FrameLayout
                        android:layout_width="@dimen/tile_size"
                        android:layout_height="@dimen/tile_size"
                        android:background="@drawable/bg_icon_neutral">

                        <ImageView
                            android:layout_width="@dimen/tile_glyph"
                            android:layout_height="@dimen/tile_glyph"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            app:srcCompat="@drawable/ic_acc_devices"
                            app:tint="@color/icon_glyph_neutral" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_marginEnd="@dimen/space_8"
                        android:layout_weight="1"
                        android:text="@string/account_hub_devices"
                        android:textAppearance="@style/TextAppearance.App.Title" />

                    <TextView
                        android:id="@+id/tv_row_value_devices"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_8"
                        android:gravity="end"
                        android:textAppearance="@style/TextAppearance.App.Subtitle"
                        android:visibility="gone"
                        tools:text="1 / 3" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="@dimen/space_4"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_chevron_right"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="@dimen/divider_inset_start"
                    android:background="?attr/colorOutlineVariant" />

                <!-- История платежей -->
                <LinearLayout
                    android:id="@+id/row_history"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/row_min_height"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/screen_gutter"
                    android:paddingEnd="@dimen/screen_gutter"
                    android:paddingVertical="@dimen/space_8">

                    <FrameLayout
                        android:layout_width="@dimen/tile_size"
                        android:layout_height="@dimen/tile_size"
                        android:background="@drawable/bg_icon_neutral">

                        <ImageView
                            android:layout_width="@dimen/tile_glyph"
                            android:layout_height="@dimen/tile_glyph"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            app:srcCompat="@drawable/ic_acc_history"
                            app:tint="@color/icon_glyph_neutral" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_marginEnd="@dimen/space_8"
                        android:layout_weight="1"
                        android:text="@string/account_hub_history"
                        android:textAppearance="@style/TextAppearance.App.Title" />

                    <TextView
                        android:id="@+id/tv_row_value_history"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_8"
                        android:gravity="end"
                        android:textAppearance="@style/TextAppearance.App.Subtitle"
                        android:visibility="gone"
                        tools:text="12.06.2026" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="@dimen/space_4"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_chevron_right"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ Способы входа ============
             What this account can be signed in with, which the desktop names as its own block
             («Способы входа», AccountView.axaml) and Android did not have at all. Today the
             product has exactly one method, so the section states one row — and it states the
             ACCOUNT it is linked to, not only the method, because "Telegram" alone answers a
             question nobody asked. It is informational: there is no unlink action behind it, so
             there is no chevron and the row is not clickable. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:layout_marginBottom="@dimen/space_8"
            android:text="@string/account_login_methods"
            android:textAppearance="@style/TextAppearance.App.Title" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="@dimen/radius_card"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:id="@+id/row_login_telegram"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/row_min_height"
                android:orientation="horizontal"
                android:paddingStart="@dimen/screen_gutter"
                android:paddingEnd="@dimen/screen_gutter"
                android:paddingVertical="@dimen/space_8">

                <FrameLayout
                    android:layout_width="@dimen/tile_size"
                    android:layout_height="@dimen/tile_size"
                    android:background="@drawable/bg_icon_neutral">

                    <ImageView
                        android:layout_width="@dimen/tile_glyph"
                        android:layout_height="@dimen/tile_glyph"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_telegram_24dp"
                        app:tint="@color/icon_glyph_neutral" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_marginEnd="@dimen/space_8"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/account_login_telegram"
                        android:textAppearance="@style/TextAppearance.App.Title" />

                    <TextView
                        android:id="@+id/tv_login_telegram_state"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/account_login_telegram_unlinked"
                        android:textAppearance="@style/TextAppearance.App.Subtitle"
                        tools:text="Привязан · @erlish" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ Аккаунт и вход: the terminal action, in its own group ============
             Its own group, not the last row of «Управление» (23-account-rework.md 2): signing
             out is not managing a subscription, and a terminal action sitting directly under
             «История платежей» in the same shape invites the mis-tap that costs the session.
             Row.Destructive per 23-account-rework.md 3.1: no value, no chevron — there is no
             destination and nothing to state. The TILE STAYS NEUTRAL (styles.xml,
             Widget.Departament.Row.Destructive): red tile plus red title is the same signal
             twice. The tile is present because every other row on this surface has one and a
             surface has exactly one text origin (23-account-rework.md 2, "origin discipline");
             the reworked tab drops tiles from all four rows at once, not from this one alone. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:layout_marginBottom="@dimen/space_8"
            android:text="@string/account_group_signin"
            android:textAppearance="@style/TextAppearance.App.Title" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="@dimen/radius_card"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:id="@+id/row_logout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:contentDescription="@string/account_row_logout"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="@dimen/row_min_height"
                android:orientation="horizontal"
                android:paddingStart="@dimen/screen_gutter"
                android:paddingEnd="@dimen/screen_gutter"
                android:paddingVertical="@dimen/space_8">

                <FrameLayout
                    android:layout_width="@dimen/tile_size"
                    android:layout_height="@dimen/tile_size"
                    android:background="@drawable/bg_icon_neutral">

                    <ImageView
                        android:layout_width="@dimen/tile_glyph"
                        android:layout_height="@dimen/tile_glyph"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_acc_logout"
                        app:tint="@color/icon_glyph_neutral" />
                </FrameLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_marginEnd="@dimen/space_8"
                    android:layout_weight="1"
                    android:text="@string/account_row_logout"
                    android:textAppearance="@style/TextAppearance.App.Title.Destructive" />

                <!-- In-flight indicator, shown only once the wipe passes 300ms (00-rules.md 7.3).
                     The row keeps its height, so nothing reflows when it appears. -->
                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/pb_logout"
                    style="@style/Widget.Departament.Progress.Circular.Inline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
