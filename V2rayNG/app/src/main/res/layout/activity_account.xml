<?xml version="1.0" encoding="utf-8"?>
<!--
  Account HUB, hosted in-place as the Account bottom-nav tab.
  Settings-style: a compact profile card + a subscription summary + grouped entry rows
  that open sub-screens (buy / devices / history). Incy language: pure dark, ONE blue
  accent, brand type, token spacing/radii/tiles, sentence-case Russian, 0 elevation,
  1dp colorOutlineVariant stroke, no nested cards, no gradients.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_gutter"
        android:paddingTop="@dimen/space_12"
        android:paddingBottom="@dimen/space_24">

        <!-- ============ 1. Profile card (compact) ============ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_4"
            android:layout_marginBottom="@dimen/space_8"
            android:text="@string/account_profile_title"
            android:textAppearance="@style/TextAppearance.App.Title" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="@dimen/radius_card"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_16">

                <!-- Avatar + name -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/avatar_container"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:clickable="true"
                        android:contentDescription="@string/account_change_avatar"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless">

                        <View
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_avatar_circle" />

                        <TextView
                            android:id="@+id/tv_avatar_initial"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:text="?"
                            android:textColor="?attr/iconTintBlue"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            tools:ignore="HardcodedText" />

                        <ImageView
                            android:id="@+id/img_avatar"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:scaleType="centerCrop"
                            android:visibility="gone" />

                        <ImageView
                            android:id="@+id/img_avatar_edit"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="bottom|end"
                            android:background="@drawable/bg_avatar_edit"
                            android:importantForAccessibility="no"
                            android:padding="@dimen/space_4"
                            app:srcCompat="@drawable/ic_acc_camera" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tv_email"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.App.Subtitle"
                        tools:text="Erlish" />
                </LinearLayout>

                <!-- Balance is the hero of the plate: quiet label above, then the big
                     brand-font value with the top-up pill right-aligned on the same line. -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:text="@string/account_balance"
                    android:textAppearance="@style/TextAppearance.App.Caption" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_balance"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:fontFeatureSettings="&quot;tnum&quot; on, &quot;lnum&quot; on"
                        android:textAppearance="@style/TextAppearance.App.Display"
                        tools:text="1 500 ₽" />

                    <!-- Compact primary pill, right of the balance line -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_top_up"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="@dimen/space_16"
                        android:paddingTop="@dimen/space_8"
                        android:paddingEnd="@dimen/space_16"
                        android:paddingBottom="@dimen/space_8"
                        android:text="@string/account_top_up"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        app:cornerRadius="20dp"
                        app:icon="@drawable/ic_add_24dp"
                        app:iconGravity="textStart"
                        app:iconSize="18dp" />
                </LinearLayout>

                <!-- Referral: ONE quiet chip reading just the code; copy is the trailing
                     icon/tap (no "копировать" word). Kept below the balance row. -->
                <LinearLayout
                    android:id="@+id/row_referral"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_referral"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_acc_chip"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:paddingHorizontal="@dimen/space_12"
                        android:paddingVertical="@dimen/space_8"
                        android:textAppearance="@style/TextAppearance.App.Caption"
                        tools:text="Реф-код ABC123" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_copy_referral"
                        style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_4"
                        android:contentDescription="@string/account_copy_referral"
                        app:icon="@drawable/ic_copy"
                        app:iconSize="18dp"
                        app:iconTint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Payment-processing hint (shown while re-polling after a checkout) -->
        <TextView
            android:id="@+id/tv_pending"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:background="@drawable/bg_acc_chip"
            android:padding="@dimen/space_12"
            android:text="@string/account_payment_pending"
            android:textAppearance="@style/TextAppearance.App.Body"
            android:visibility="gone" />

        <!-- ============ 2. Subscription summary ============ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_4"
            android:layout_marginTop="@dimen/space_24"
            android:layout_marginBottom="@dimen/space_8"
            android:text="@string/account_sub_summary_title"
            android:textAppearance="@style/TextAppearance.App.Title" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="@dimen/radius_card"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_16">

                <!-- Empty state: inviting onboarding block, shown ONLY when there is no subscription.
                     btn_no_sub_buy is a GONE placeholder the code can wire to the buy flow later. -->
                <TextView
                    android:id="@+id/tv_no_sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/account_no_subscription"
                    android:textAppearance="@style/TextAppearance.App.Body"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_no_sub_buy"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="@dimen/space_16"
                    android:text="@string/account_hub_buy"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:cornerRadius="26dp"
                    app:icon="@drawable/ic_acc_upgrade"
                    app:iconGravity="textStart" />

                <!-- Active state -->
                <LinearLayout
                    android:id="@+id/group_active_sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Header row: subscription name (left) + tariff badge (right) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_sub_name"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textAppearance="@style/TextAppearance.App.Title"
                            tools:text="Premium" />

                        <TextView
                            android:id="@+id/tv_tariff_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_8"
                            android:background="@drawable/bg_acc_badge"
                            android:paddingHorizontal="@dimen/space_8"
                            android:paddingVertical="@dimen/space_4"
                            android:textAppearance="@style/TextAppearance.App.Chip"
                            android:textColor="?attr/colorPrimary"
                            android:visibility="gone"
                            tools:ignore="HardcodedText"
                            tools:text="Base"
                            tools:visibility="visible" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_sub_expiry"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:textAppearance="@style/TextAppearance.App.Subtitle"
                        tools:text="Действует до 31.12.2026" />

                    <TextView
                        android:id="@+id/tv_sub_devices"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:textAppearance="@style/TextAppearance.App.Subtitle"
                        tools:text="Устройства: 1 / 3" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/space_16"
                        android:background="?attr/colorOutlineVariant" />

                    <!-- Auto-renew -->
                    <LinearLayout
                        android:id="@+id/row_auto_renew"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/row_min_height"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/account_auto_renew"
                            android:textAppearance="@style/TextAppearance.App.Body" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_auto_renew"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ 3. Entry rows (open sub-screens) ============ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_4"
            android:layout_marginTop="@dimen/space_24"
            android:layout_marginBottom="@dimen/space_8"
            android:text="@string/account_manage_title"
            android:textAppearance="@style/TextAppearance.App.Title" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="@dimen/radius_card"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Купить подписку -->
                <LinearLayout
                    android:id="@+id/row_buy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/row_min_height"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/screen_gutter"
                    android:paddingEnd="@dimen/screen_gutter"
                    android:paddingVertical="@dimen/space_8">

                    <FrameLayout
                        android:layout_width="@dimen/tile_size"
                        android:layout_height="@dimen/tile_size"
                        android:background="@drawable/bg_icon_blue">

                        <ImageView
                            android:layout_width="@dimen/tile_glyph"
                            android:layout_height="@dimen/tile_glyph"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            app:srcCompat="@drawable/ic_acc_upgrade"
                            app:tint="?attr/iconTintBlue" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_16"
                        android:layout_marginEnd="@dimen/space_8"
                        android:layout_weight="1"
                        android:text="@string/account_hub_buy"
                        android:textAppearance="@style/TextAppearance.App.Title"
                        android:textColor="?attr/colorPrimary" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="@dimen/space_4"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_chevron_right"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="72dp"
                    android:background="?attr/colorOutlineVariant" />

                <!-- Устройства -->
                <LinearLayout
                    android:id="@+id/row_devices"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/row_min_height"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/screen_gutter"
                    android:paddingEnd="@dimen/screen_gutter"
                    android:paddingVertical="@dimen/space_8">

                    <FrameLayout
                        android:layout_width="@dimen/tile_size"
                        android:layout_height="@dimen/tile_size"
                        android:background="@drawable/bg_icon_neutral">

                        <ImageView
                            android:layout_width="@dimen/tile_glyph"
                            android:layout_height="@dimen/tile_glyph"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            app:srcCompat="@drawable/ic_acc_devices"
                            app:tint="@color/icon_glyph_neutral" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_16"
                        android:layout_marginEnd="@dimen/space_8"
                        android:layout_weight="1"
                        android:text="@string/account_hub_devices"
                        android:textAppearance="@style/TextAppearance.App.Title" />

                    <!-- GONE trailing value slot; code can fill with e.g. "1 / 3" -->
                    <TextView
                        android:id="@+id/tv_row_value_devices"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_8"
                        android:gravity="end"
                        android:textAppearance="@style/TextAppearance.App.Numeric"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="13sp"
                        android:visibility="gone"
                        tools:text="1 / 3" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="@dimen/space_4"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_chevron_right"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="72dp"
                    android:background="?attr/colorOutlineVariant" />

                <!-- История платежей -->
                <LinearLayout
                    android:id="@+id/row_history"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/row_min_height"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/screen_gutter"
                    android:paddingEnd="@dimen/screen_gutter"
                    android:paddingVertical="@dimen/space_8">

                    <FrameLayout
                        android:layout_width="@dimen/tile_size"
                        android:layout_height="@dimen/tile_size"
                        android:background="@drawable/bg_icon_neutral">

                        <ImageView
                            android:layout_width="@dimen/tile_glyph"
                            android:layout_height="@dimen/tile_glyph"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            app:srcCompat="@drawable/ic_acc_history"
                            app:tint="@color/icon_glyph_neutral" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_16"
                        android:layout_marginEnd="@dimen/space_8"
                        android:layout_weight="1"
                        android:text="@string/account_hub_history"
                        android:textAppearance="@style/TextAppearance.App.Title" />

                    <!-- GONE trailing value slot; code can fill with e.g. a last-payment date -->
                    <TextView
                        android:id="@+id/tv_row_value_history"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_8"
                        android:gravity="end"
                        android:textAppearance="@style/TextAppearance.App.Numeric"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="13sp"
                        android:visibility="gone"
                        tools:text="12.06.2026" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="@dimen/space_4"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_chevron_right"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
