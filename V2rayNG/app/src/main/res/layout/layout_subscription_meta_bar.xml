<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/meta_bar_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginTop="8dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="2dp"
    android:background="@drawable/bg_server_card"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="14dp">

    <!-- Row 1: chevron + (title + subtitle) + actions (Ping -> Refresh -> Pin) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btn_collapse"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/title_servers"
            android:focusable="true"
            android:padding="4dp"
            app:srcCompat="@drawable/ic_arrow_drop_down"
            app:tint="?attr/colorOnSurfaceVariant" />

        <!-- Title + meta subtitle (last update + auto-update) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_sub_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/colorOnSurface"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="erlish" />

            <TextView
                android:id="@+id/tv_meta_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11sp"
                android:visibility="gone"
                tools:text="09.07.2026 07:08 · Автообновление — 1 ч."
                tools:visibility="visible" />

        </LinearLayout>

        <!-- 1) Ping / latency test -->
        <ImageView
            android:id="@+id/btn_ping"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/connection_test_pending"
            android:focusable="true"
            android:padding="8dp"
            app:srcCompat="@drawable/ic_ping_24dp"
            app:tint="?attr/colorPrimary" />

        <!-- 2) Refresh subscription -->
        <ImageView
            android:id="@+id/btn_refresh"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/title_sub_update"
            android:focusable="true"
            android:padding="8dp"
            app:srcCompat="@drawable/ic_refresh_24dp"
            app:tint="?attr/colorPrimary" />

        <ProgressBar
            android:id="@+id/progress_action"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:indeterminateTint="?attr/colorPrimary"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- 3) Pin (last) -->
        <ImageView
            android:id="@+id/btn_pin"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/sub_pin"
            android:focusable="true"
            android:padding="8dp"
            app:srcCompat="@drawable/ic_pin_24dp"
            app:tint="?attr/colorOnSurfaceVariant" />

    </LinearLayout>

    <!-- Collapsible body: traffic + announce + support/telegram. Starts EXPANDED. -->
    <LinearLayout
        android:id="@+id/layout_meta_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible">

    <!-- Row 2: compact Happ-style traffic pill (left, ~half width) + expiry marker (right,
         same line). Horizontal so the ∞ / "до <date>" sits in the top-right corner. -->
    <LinearLayout
        android:id="@+id/layout_traffic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Traffic pill: thin rounded track with the usage label centered on it. Takes ~half
             the row (weight) so it is about 2x shorter than the old full-width bar. -->
        <FrameLayout
            android:id="@+id/layout_traffic_pill"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress_traffic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:max="1000"
                app:indicatorColor="@color/colorPing"
                app:indicatorTrackGapSize="0dp"
                app:trackColor="?attr/colorSurfaceVariant"
                app:trackCornerRadius="8dp"
                app:trackStopIndicatorSize="0dp"
                app:trackThickness="16dp"
                tools:progress="430" />

            <TextView
                android:id="@+id/tv_traffic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="?attr/colorOnSurface"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="1,7 ТБ / ∞" />

        </FrameLayout>

        <!-- Expiry marker (∞ or "до <date>") in the top-right corner, same line as the pill -->
        <TextView
            android:id="@+id/tv_expiry"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:gravity="end"
            android:maxLines="1"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp"
            tools:text="до 12.08.2026" />

    </LinearLayout>

    <!-- Announce banner from the subscription (centered) -->
    <TextView
        android:id="@+id/tv_announce"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:autoLink="web"
        android:gravity="center"
        android:maxLines="5"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textColorLink="?attr/colorPrimary"
        android:textSize="12sp"
        android:visibility="gone"
        tools:text="No ads on YouTube: Hybrid, Russia\nIf it stops working, refresh the subscription @departamentvpn"
        tools:visibility="visible" />

    <!-- Support / Telegram buttons -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_support"
            style="@style/Widget.Material3.Button.TonalButton.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="16dp"
            android:text="@string/sub_support"
            android:textSize="12sp"
            android:visibility="gone"
            app:icon="@drawable/ic_support_24dp"
            app:iconSize="16dp"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_telegram"
            style="@style/Widget.Material3.Button.TextButton.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="@string/sub_telegram"
            android:textSize="12sp"
            android:visibility="gone"
            app:icon="@drawable/ic_telegram_24dp"
            app:iconSize="16dp"
            tools:visibility="visible" />

    </LinearLayout>

    </LinearLayout>

</LinearLayout>
